# Cargo's build output.
/target/

{% if rust_crate and not commits_lock %}
# A library repository commits no lock file: the revisions that build together
# are recorded by each application's lock file, and every repository's pipeline
# builds it on its own against its pinned sources.
/Cargo.lock

{% endif %}
