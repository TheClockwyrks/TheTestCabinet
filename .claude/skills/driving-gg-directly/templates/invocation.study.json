            }
          },
          {
            "id": "responses-as-code",
            "enabled": true,
            "params": {
              "language": "<filled, or the capability is removed for a tools run>",
              "timeoutSecs": 30,
              "maxMemoryBytes": 268435456,
              "docViewTypes": {
                "return": true,
                "parameters": false,
                "errors": true
              }
            }
          }
        ],
        "tools": [
          "shell",
          "read_file",
          "write_file",
          "edit_file",
          "list_dir",
          "tree",
          "search",
          "spawn_subagent",
          "wait_for_subagents",
          "send_message"
        ],
        "operations": [
          "shell.shell",
          "files.read_file",
          "files.write_file",
          "files.edit_file",
          "files.list_dir",
          "files.tree",
          "files.search",
          "views.open_file",
          "delegation.spawn_subagent",
          "delegation.wait_for_subagents",
          "delegation.send_message"
        ],
        "openingTurn": {
          "modules": ["files", "shell"],
