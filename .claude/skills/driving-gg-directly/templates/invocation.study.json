            "views.open_docs_view",
            "views.open_text",
            "views.open_file",
            "files.search"
          ],
          "tree": {
            "include": true,
            "depth": 2
          }
        },
        "subagents": [
          {
            "agentId": "root",
            "description": "A copy of yourself with a fresh context window. Delegate a self-contained slice of the work with a complete brief; it returns its final text.",
            "scopes": ["subagent"]
          }
        ],
        "hooks": [
          {
            "event": "pre-shell",
            "name": "no destructive git or rm",
            "action": {
              "type": "built-in",
              "script": "guard-destructive-shell"
            }
          }
        ],
        "promptCacheTtl": "extended"
      }
