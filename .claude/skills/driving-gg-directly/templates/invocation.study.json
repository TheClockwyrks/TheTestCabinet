    "agents": [
      {
        "slug": "root",
        "name": "Root",
        "modelId": "<filled>",
        "capabilities": [
          {
            "id": "shell",
            "enabled": true,
            "implementation": "offload",
            "params": {
              "maxLines": 250,
              "maxChars": 4096
            }
          },
          {
            "id": "read-file",
            "enabled": true,
            "implementation": "unlimited",
            "params": {
              "lineCap": 250
            }
          },
          {
            "id": "write-file",
            "enabled": true,
            "params": {}
          },
          {
            "id": "edit-file",
            "enabled": true,
            "params": {}
          },
          {
            "id": "list-dir",
            "enabled": true,
            "params": {}
          },
          {
            "id": "search",
            "enabled": true,
            "params": {}
          },
          {
            "id": "tasks",
            "enabled": false,
            "params": {
              "maxTasks": 100,
              "mode": "simple"
            }
          },
          {
            "id": "context-window-override",
            "enabled": true,
            "params": {
              "windowLimit": 400000
            }
          },
          {
            "id": "compaction",
            "enabled": true,
            "implementation": "self-summarization",
