{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "askUserQuestionTimeout": "never",
  "autoContinueAtUsageLimit": true,
  "autoCompactWindow": 400000,
  "autoInstallIdeExtension": false,
  "awaySummaryEnabled": false,
  "emojiCompletionEnabled": false,
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "promptSuggestionEnabled": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-bare-sleep.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-cargo-test.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-self-matching-pgrep.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-done-task-writes.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
