{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.testcabinet.ai/schema/core/run-record.schema.json",
  "title": "RunRecord",
  "description": "The central data contract for a single Test Cabinet benchmark run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "startedAt",
    "finishedAt",
    "subject",
    "tooling",
    "environment",
    "metrics",
    "validation",
    "links",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/RunSubject" },
    "tooling": { "$ref": "#/$defs/RunTooling" },
    "environment": { "$ref": "#/$defs/RunEnvironment" },
    "metrics": { "$ref": "#/$defs/RunMetrics" },
    "validation": { "$ref": "#/$defs/RunValidation" },
    "links": { "$ref": "#/$defs/RunLinks" },
    "status": { "$ref": "#/$defs/RunStatus" }
  },
  "$defs": {
    "HarnessSlug": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "cline",
        "antigravity",
        "goose",
        "kilo",
        "opencode",
        "pi"
      ]
    },
    "RunState": {
      "type": "string",
      "enum": ["completed", "failed", "unevaluable"]
    },
    "TestType": {
      "type": "string",
      "enum": ["end-to-end", "asset-generation", "adversarial"]
    },
    "RunSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testCaseSlug",
        "testCaseVersion",
        "testType",
        "variant",
        "harnessSlug",
        "harnessVersion",
        "modelId"
      ],
      "properties": {
        "testCaseSlug": { "type": "string" },
        "testCaseVersion": { "type": "string" },
        "testType": { "$ref": "#/$defs/TestType" },
        "variant": { "type": "string" },
        "harnessSlug": { "$ref": "#/$defs/HarnessSlug" },
        "harnessVersion": { "type": ["string", "null"] },
        "modelId": { "type": "string" }
      }
    },
    "RunTooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testCabinetCommit"],
      "properties": {
        "testCabinetCommit": { "type": ["string", "null"] }
      }
    },
    "RunEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "containerImage", "nodeVersion", "authMode"],
      "properties": {
        "os": { "type": "string" },
        "containerImage": { "type": "string" },
        "nodeVersion": { "type": ["string", "null"] },
        "authMode": { "enum": ["apiKey", "subscription"] }
      }
    },
    "TokenMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncachedInput", "cachedInput", "output", "reasoning"],
      "properties": {
        "uncachedInput": { "type": "integer" },
        "cachedInput": { "type": "integer" },
        "output": { "type": "integer" },
        "reasoning": { "type": "integer" }
      }
    },
    "CostMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparable", "actual"],
      "properties": {
        "comparable": { "type": "number" },
        "actual": { "type": "number" }
      }
    },
    "RunMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runTimeSeconds", "tokens", "cost"],
      "properties": {
        "runTimeSeconds": { "type": "number" },
        "tokens": { "$ref": "#/$defs/TokenMetrics" },
        "cost": { "$ref": "#/$defs/CostMetrics" }
      }
    },
    "CheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "name", "reached", "similarity", "detail"],
      "properties": {
        "view": { "type": "string" },
        "name": { "type": "string" },
        "reached": { "type": "boolean" },
        "similarity": { "type": "number" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "ProofResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "dest", "present", "detail"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["image", "video"] },
        "dest": { "type": "string" },
        "present": { "type": "boolean" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "StepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "succeeded", "detail"],
      "properties": {
        "command": { "type": "string" },
        "succeeded": { "type": "boolean" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "AssetGenResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regeneratedImage",
        "previewImage",
        "actionsLog",
        "operationCount",
        "cheatDivergence",
        "detail"
      ],
      "properties": {
        "regeneratedImage": { "type": "string" },
        "previewImage": { "type": "string" },
        "actionsLog": { "type": "string" },
        "operationCount": { "type": "integer" },
        "cheatDivergence": { "type": ["number", "null"] },
        "detail": { "type": ["string", "null"] }
      }
    },
    "AdversarialTeam": {
      "type": "string",
      "enum": ["red", "blue"]
    },
    "AdversarialOutcome": {
      "type": "string",
      "enum": ["win", "loss", "draw", "forfeit"]
    },
    "AdversarialResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayJson",
        "opponent",
        "submissionTeam",
        "winner",
        "redScore",
        "blueScore",
        "ended",
        "ticks",
        "outcome",
        "detail"
      ],
      "properties": {
        "replayJson": { "type": "string" },
        "opponent": { "type": "string" },
        "submissionTeam": { "$ref": "#/$defs/AdversarialTeam" },
        "winner": {
          "oneOf": [{ "$ref": "#/$defs/AdversarialTeam" }, { "type": "null" }]
        },
        "redScore": { "type": "number" },
        "blueScore": { "type": "number" },
        "ended": { "type": "string" },
        "ticks": { "type": "integer" },
        "outcome": { "$ref": "#/$defs/AdversarialOutcome" },
        "detail": { "type": ["string", "null"] }
      }
    },
    "RunValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded", "detail", "install", "build", "checks", "proofs"],
      "properties": {
        "loaded": { "type": "boolean" },
        "detail": { "type": ["string", "null"] },
        "install": {
          "oneOf": [{ "$ref": "#/$defs/StepResult" }, { "type": "null" }]
        },
        "build": {
          "oneOf": [{ "$ref": "#/$defs/StepResult" }, { "type": "null" }]
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/CheckResult" }
        },
        "proofs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProofResult" }
        },
        "asset": { "$ref": "#/$defs/AssetGenResult" },
        "adversarial": { "$ref": "#/$defs/AdversarialResult" }
      }
    },
    "RunLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRepo", "playableBuild"],
      "properties": {
        "sourceRepo": { "type": ["string", "null"] },
        "playableBuild": { "type": ["string", "null"] }
      }
    },
    "RunStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "detail"],
      "properties": {
        "state": { "$ref": "#/$defs/RunState" },
        "detail": { "type": ["string", "null"] }
      }
    }
  }
}
