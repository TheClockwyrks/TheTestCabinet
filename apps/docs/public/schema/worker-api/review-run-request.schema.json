{
  "$id": "https://docs.testcabinet.ai/schema/worker-api/review-run-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The body of `POST /review`: a review for an already-pushed run.",
  "properties": {
    "checklist": {
      "default": [],
      "description": "The reviewer's verdicts on the case's declared checklist items.",
      "items": {
        "$ref": "https://docs.testcabinet.ai/schema/backend-api/review.schema.json#/$defs/ReviewVerdict"
      },
      "type": "array"
    },
    "ratings": {
      "description": "The reviewer's quality rating for each scoring domain.",
      "items": {
        "$ref": "https://docs.testcabinet.ai/schema/backend-api/review.schema.json#/$defs/DomainRating"
      },
      "type": "array"
    },
    "runId": {
      "description": "The run to review.",
      "type": "string"
    },
    "writeup": {
      "description": "The writeup prose (markdown body).",
      "type": "string"
    }
  },
  "required": ["ratings", "runId", "writeup"],
  "title": "ReviewBody",
  "type": "object"
}
