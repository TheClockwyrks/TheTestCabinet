{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.testcabinet.ai/schema/backend-api/error.schema.json",
  "title": "BackendError",
  "description": "The single error envelope every backend HTTP endpoint returns on failure, paired with an appropriate HTTP status code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "A stable, machine-readable error code."
        },
        "message": {
          "type": "string",
          "description": "A human-readable description of the failure."
        }
      }
    }
  }
}
