{
  "$defs": {
    "AssetKind": {
      "description": "Within an asset-generation case, the shape of the asset the model draws.\n\nA case is one of: a single 2D sprite, a 2D sprite sheet, a single static 3D\nvoxel model, or a rigged/animatable 3D voxel model — never a mix, and not a\nper-variant choice: it is a property of the whole version, chosen by the\n`asset_kind` field. A [`Self::SpriteSheet`] case additionally declares a\n`[sheet]` table (the frame grid and the named animation sequences); the two\nvoxel kinds declare a `[voxel]` table (the bounding volume), and\n[`Self::VoxelAnimation`] additionally declares a `[model]` table (the parts,\njoints, and clips of the rig). Defaults to [`Self::Sprite`] so a manifest that\npredates the discriminator — and every non-asset-generation case — resolves\nunchanged.",
      "oneOf": [
        {
          "const": "sprite",
          "description": "One sprite drawn onto the whole canvas (the original asset-generation shape).",
          "type": "string"
        },
        {
          "const": "sprite-sheet",
          "description": "A grid of animation frames drawn onto the canvas, sliced into the named\nsequences the `[sheet]` table declares.",
          "type": "string"
        },
        {
          "const": "voxel-model",
          "description": "A single static 3D voxel model, drawn one voxel operation at a time with the\n`voxel` binary. Declares a `[voxel]` table (the bounding volume). Rendered as\nan auto-rotating 3D model.",
          "type": "string"
        },
        {
          "const": "voxel-animation",
          "description": "A rigged, animatable 3D voxel model: named parts in a parent/child hierarchy\nwith named joints a consuming game drives at runtime (for example a tank's\n`turret_yaw`), drawn with the `voxel-anim` binary. Declares a `[voxel]` table\nand a `[model]` table (the required parts and joints the model must produce,\non top of which it may add its own).",
          "type": "string"
        }
      ]
    },
    "AssetOut": {
      "properties": {
        "dest": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": ["source", "dest"],
      "type": "object"
    },
    "BuildOut": {
      "properties": {
        "build": {
          "type": "string"
        },
        "install": {
          "type": "string"
        },
        "module": {
          "type": ["string", "null"]
        }
      },
      "required": ["install", "build"],
      "type": "object"
    },
    "CanvasOut": {
      "properties": {
        "background": {
          "type": "string"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["width", "height", "background"],
      "type": "object"
    },
    "CheckAction": {
      "description": "A single action that drives a served implementation toward a view.\n\nSerializes to the JSON shape the browser driver consumes (an internally\ntagged `{ \"type\": … }` object); see `packages/browser-driver/driver.mjs`.",
      "oneOf": [
        {
          "description": "Pause for `ms` milliseconds.",
          "properties": {
            "ms": {
              "description": "Duration to wait, in milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "wait",
              "type": "string"
            }
          },
          "required": ["type", "ms"],
          "type": "object"
        },
        {
          "description": "Press and release a key (Playwright key name, e.g. `Enter`, `ArrowUp`).",
          "properties": {
            "key": {
              "description": "The key to press.",
              "type": "string"
            },
            "type": {
              "const": "key",
              "type": "string"
            }
          },
          "required": ["type", "key"],
          "type": "object"
        },
        {
          "description": "Hold a key down for `ms` milliseconds, then release it.",
          "properties": {
            "key": {
              "description": "The key to hold.",
              "type": "string"
            },
            "ms": {
              "description": "How long to hold it, in milliseconds.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "hold",
              "type": "string"
            }
          },
          "required": ["type", "key", "ms"],
          "type": "object"
        },
        {
          "description": "Click a logical-pixel point on the page.",
          "properties": {
            "type": {
              "const": "click",
              "type": "string"
            },
            "x": {
              "description": "Horizontal position, in logical pixels.",
              "format": "double",
              "type": "number"
            },
            "y": {
              "description": "Vertical position, in logical pixels.",
              "format": "double",
              "type": "number"
            }
          },
          "required": ["type", "x", "y"],
          "type": "object"
        }
      ]
    },
    "CheckOut": {
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/CheckAction"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "referenceView": {
          "type": "string"
        },
        "view": {
          "type": "string"
        }
      },
      "required": ["view", "name", "referenceView", "actions"],
      "type": "object"
    },
    "DomainOut": {
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name", "description"],
      "type": "object"
    },
    "OutputOut": {
      "properties": {
        "actions": {
          "type": "string"
        }
      },
      "required": ["actions"],
      "type": "object"
    },
    "ProofOut": {
      "properties": {
        "dest": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/MediaKind"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name", "kind", "dest"],
      "type": "object"
    },
    "ReferenceKind": {
      "description": "How a reference view's source is turned into the seeded/served artifact.",
      "oneOf": [
        {
          "const": "rendered",
          "description": "An HTML mockup rendered to a PNG screenshot. The served media is always an\nimage.",
          "type": "string"
        },
        {
          "const": "image",
          "description": "A static image file used as-is.",
          "type": "string"
        },
        {
          "const": "video",
          "description": "A static video file (`mp4`) used as-is.",
          "type": "string"
        }
      ]
    },
    "ReferenceOut": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReferenceKind",
          "description": "How the reference is produced (`rendered`, `image`, or `video`)."
        },
        "mediaUrl": {
          "description": "The URL path the reference media is served under.",
          "type": "string"
        },
        "view": {
          "type": "string"
        }
      },
      "required": ["view", "kind", "mediaUrl"],
      "type": "object"
    },
    "ReviewItemOut": {
      "properties": {
        "domain": {
          "type": ["string", "null"]
        },
        "id": {
          "type": "string"
        },
        "proof": {
          "type": ["string", "null"]
        },
        "reference": {
          "type": ["string", "null"]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "weight": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["id", "title", "text", "weight"],
      "type": "object"
    },
    "SpecOut": {
      "properties": {
        "dest": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "template": {
          "type": "boolean"
        }
      },
      "required": ["source", "dest", "template"],
      "type": "object"
    },
    "StoredContract": {
      "description": "The submission contract of an adversarial or performance case persisted in a\n[`StoredManifest`]. Path fields are forward-slashed run-workspace-relative keys.\nAdversarial carries the per-tick `world`/`action` schemas; performance carries\nthe per-scenario `input`/`output` schemas. The pairs are `Option` so the two\ntypes coexist on one stored shape (only one pair is set).",
      "properties": {
        "action": {
          "description": "Adversarial only: the seeded `action` schema path.",
          "type": ["string", "null"]
        },
        "entry": {
          "description": "The exported function invoked once per tick (adversarial) or once per\nscenario (performance).",
          "type": "string"
        },
        "input": {
          "description": "Performance only: the seeded `input` (scenario) schema path.",
          "type": ["string", "null"]
        },
        "output": {
          "description": "Performance only: the seeded `output` (state) schema path.",
          "type": ["string", "null"]
        },
        "world": {
          "description": "Adversarial only: the seeded `world` observation schema path.",
          "type": ["string", "null"]
        }
      },
      "required": ["entry"],
      "type": "object"
    },
    "StoredMatch": {
      "description": "How an adversarial case pairs implementations into matches, persisted in a\n[`StoredManifest`].",
      "properties": {
        "participants": {
          "description": "Controllers per match.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rounds": {
          "description": "Matches played per pairing.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "structure": {
          "description": "How the field is paired (for example `round-robin`).",
          "type": "string"
        }
      },
      "required": ["participants", "structure", "rounds"],
      "type": "object"
    },
    "StoredReplay": {
      "description": "How an adversarial case renders a recorded match for browser playback,\npersisted in a [`StoredManifest`].",
      "properties": {
        "renderer": {
          "description": "The run-workspace-relative path the renderer is seeded to, forward-slashed.",
          "type": "string"
        }
      },
      "required": ["renderer"],
      "type": "object"
    },
    "StoredSandbox": {
      "description": "The sandbox limits of an adversarial or performance case persisted in a\n[`StoredManifest`]. Adversarial meters per tick (`fuel_per_tick`); performance\nmeters per scenario (`fuel_limit`). Both fuel fields are `Option` so the two\ntypes coexist (only one is set).",
      "properties": {
        "fuelLimit": {
          "description": "Performance only: the wasmtime fuel ceiling for a whole scenario.",
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "fuelPerTick": {
          "description": "Adversarial only: the wasmtime fuel ceiling for a single tick.",
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "maxMemoryBytes": {
          "description": "The linear-memory cap in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["maxMemoryBytes"],
      "type": "object"
    },
    "StoredSimulation": {
      "description": "The simulation-loop configuration of an adversarial case persisted in a\n[`StoredManifest`].",
      "properties": {
        "maxTicks": {
          "description": "Hard cap on match length.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "timestepMs": {
          "description": "The fixed, faked delta handed to the game logic each tick (milliseconds).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["timestepMs", "maxTicks"],
      "type": "object"
    },
    "ToolOut": {
      "properties": {
        "binary": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        }
      },
      "required": ["binary", "preview"],
      "type": "object"
    },
    "VariantOut": {
      "properties": {
        "description": {
          "type": ["string", "null"]
        },
        "domains": {
          "description": "The variant's own scoring domains, on top of the case's common\n[`VersionResponse::domains`]. Rated only when this variant is selected.",
          "items": {
            "$ref": "#/$defs/DomainOut"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "prompt": {
          "description": "The variant's prompt, rendered as a real run receives it.",
          "type": "string"
        },
        "proofs": {
          "items": {
            "$ref": "#/$defs/ProofOut"
          },
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/ReferenceOut"
          },
          "type": "array"
        },
        "reviewItems": {
          "items": {
            "$ref": "#/$defs/ReviewItemOut"
          },
          "type": "array"
        },
        "slug": {
          "type": "string"
        },
        "specs": {
          "items": {
            "$ref": "#/$defs/SpecOut"
          },
          "type": "array"
        },
        "workspace": {
          "items": {
            "$ref": "#/$defs/WorkspaceOut"
          },
          "type": ["array", "null"]
        }
      },
      "required": [
        "slug",
        "name",
        "prompt",
        "specs",
        "references",
        "proofs",
        "reviewItems",
        "domains"
      ],
      "type": "object"
    },
    "VoxelSpec": {
      "description": "The resolved `[voxel]` of a voxel asset-generation case: the bounding volume\nthe model draws into, the 3D analog of [`CanvasSpec`]. `background` is the\nclear color behind the rasterized isometric preview PNG (the voxel volume\nitself always starts empty); it is kept as the manifest string — validated to\nparse — so the resolved version stays serializable without depending on the\nvoxel library's color type, and the validator re-parses it when it regenerates.",
      "properties": {
        "background": {
          "description": "Preview clear color: `transparent` or a hex color.",
          "type": "string"
        },
        "depth": {
          "description": "Volume extent along z, in voxels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "description": "Volume extent along y (up), in voxels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Volume extent along x, in voxels.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["width", "height", "depth", "background"],
      "type": "object"
    },
    "WorkspaceOut": {
      "properties": {
        "dest": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": ["source", "dest"],
      "type": "object"
    }
  },
  "$id": "https://docs.testcabinet.ai/schema/backend-api/resolved-test-case-version.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The resolved, fully-rendered definition of one test-case version: the body of\n`GET /test-cases/{slug}/{version}`. Everything a reporter needs to present the\ncase — its metadata, the per-test-type contract/sandbox shapes, the rendered\nprompt and seeded specs, and every variant, reference, proof, check, and\nreviewer item — resolved as a real run receives them.",
  "properties": {
    "assetKind": {
      "$ref": "#/$defs/AssetKind"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetOut"
      },
      "type": "array"
    },
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/BuildOut"
        },
        {
          "type": "null"
        }
      ]
    },
    "canvas": {
      "anyOf": [
        {
          "$ref": "#/$defs/CanvasOut"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckOut"
      },
      "type": "array"
    },
    "commonProofs": {
      "items": {
        "$ref": "#/$defs/ProofOut"
      },
      "type": "array"
    },
    "commonReferences": {
      "items": {
        "$ref": "#/$defs/ReferenceOut"
      },
      "type": "array"
    },
    "commonReviewItems": {
      "items": {
        "$ref": "#/$defs/ReviewItemOut"
      },
      "type": "array"
    },
    "commonSpecs": {
      "items": {
        "$ref": "#/$defs/SpecOut"
      },
      "type": "array"
    },
    "contract": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredContract"
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": ["string", "null"]
    },
    "difficulty": {
      "type": "string"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/DomainOut"
      },
      "type": "array"
    },
    "init": {
      "type": ["string", "null"]
    },
    "match": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredMatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "maxRuntimeSeconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/ModelSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutputOut"
        },
        {
          "type": "null"
        }
      ]
    },
    "promptTemplate": {
      "type": "string"
    },
    "replay": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredReplay"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredSandbox"
        },
        {
          "type": "null"
        }
      ]
    },
    "sheet": {
      "anyOf": [
        {
          "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/AssetSheet"
        },
        {
          "type": "null"
        }
      ]
    },
    "simulation": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredSimulation"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "type": "string"
    },
    "summary": {
      "type": ["string", "null"]
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "testType": {
      "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/TestType"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolOut"
        },
        {
          "type": "null"
        }
      ]
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/VariantOut"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    },
    "voxel": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoxelSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "items": {
        "$ref": "#/$defs/WorkspaceOut"
      },
      "type": "array"
    }
  },
  "required": [
    "slug",
    "version",
    "name",
    "difficulty",
    "tags",
    "maxRuntimeSeconds",
    "testType",
    "assetKind",
    "promptTemplate",
    "commonSpecs",
    "workspace",
    "assets",
    "variants",
    "commonReferences",
    "commonProofs",
    "checks",
    "commonReviewItems",
    "domains"
  ],
  "title": "VersionResponse",
  "type": "object"
}
