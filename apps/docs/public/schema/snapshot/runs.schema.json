{
  "$defs": {
    "LinksOut": {
      "description": "A run's outbound links as the snapshot carries them.",
      "properties": {
        "playableBuild": {
          "type": ["string", "null"]
        },
        "sourceRepo": {
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "RunSummary": {
      "description": "The denormalized summary card for one published run.",
      "properties": {
        "caseName": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "links": {
          "$ref": "#/$defs/LinksOut"
        },
        "metrics": {
          "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/RunMetrics"
        },
        "publishedAt": {
          "type": "string"
        },
        "rating": {
          "$ref": "https://docs.testcabinet.ai/schema/backend-api/review.schema.json#/$defs/Rating",
          "description": "The run's overall rating: the worst rating any reviewer gave any domain."
        },
        "reviewCount": {
          "description": "How many reviews the run carries. The site averages their scores; the aggregate sits between the harshest and most generous review.",
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAt": {
          "type": "string"
        },
        "state": {
          "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/RunState"
        },
        "subject": {
          "$ref": "#/$defs/SubjectOut"
        },
        "validationLoaded": {
          "type": "boolean"
        }
      },
      "required": [
        "caseName",
        "finishedAt",
        "id",
        "links",
        "metrics",
        "publishedAt",
        "rating",
        "reviewCount",
        "startedAt",
        "state",
        "subject",
        "validationLoaded"
      ],
      "type": "object"
    },
    "SubjectOut": {
      "description": "The run subject as a summary card carries it (the slug enum, not a string).",
      "properties": {
        "harnessSlug": {
          "$ref": "https://docs.testcabinet.ai/schema/core/run-record.schema.json#/$defs/HarnessSlug"
        },
        "harnessVersion": {
          "type": ["string", "null"]
        },
        "modelId": {
          "type": "string"
        },
        "testCaseSlug": {
          "type": "string"
        },
        "testCaseVersion": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "harnessSlug",
        "modelId",
        "testCaseSlug",
        "testCaseVersion",
        "variant"
      ],
      "type": "object"
    }
  },
  "$id": "https://docs.testcabinet.ai/schema/snapshot/runs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The flat index of run summary cards (`runs.json`), newest first.",
  "properties": {
    "runs": {
      "items": {
        "$ref": "#/$defs/RunSummary"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": ["runs", "schemaVersion"],
  "title": "RunsIndex",
  "type": "object"
}
