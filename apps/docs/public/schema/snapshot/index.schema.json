{
  "$id": "https://docs.testcabinet.ai/schema/snapshot/index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The top-level snapshot pointer (`index.json`): where the runs index, per-run\ndocuments, and case documents live under this snapshot's prefix.",
  "properties": {
    "casesPrefix": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "modelsKey": {
      "description": "Where this snapshot's model catalog lives (`<prefix>/models.json`).",
      "type": "string"
    },
    "runCount": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "runsKey": {
      "type": "string"
    },
    "runsPrefix": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "snapshotId": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "generatedAt",
    "runCount",
    "runsKey",
    "runsPrefix",
    "casesPrefix",
    "modelsKey"
  ],
  "title": "SnapshotIndex",
  "type": "object"
}
