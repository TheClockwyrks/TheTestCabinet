{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    // The renderer + engine come from `@clockwyrks/lattice-runtime`; the sprite
    // sheet is the console's vendored copy of the case's atlas
    // (`@clockwyrks/ui`'s internal `pages/runs/lattice/assets`). Those files are
    // plain data, so aliasing to them keeps this tool standalone without pulling
    // the console in. Mirrors the Vite alias in `vite.config.ts`.
    "paths": {
      "@lattice-assets/*": [
        "../../packages/ui/src/app/pages/runs/lattice/assets/*"
      ],
      // The console's numeric-field rules, aliased for the same reason: one pure
      // module, so a field here behaves exactly as one there. Mirrors vite.config.ts.
      "@numeric": ["../../packages/ui/src/app/components/numberFieldRules.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "scenario-api.ts", "vitest.config.ts"]
}
