# The Test Cabinet — web console DEV defaults (`@test-cabinet/web`).
#
# Vite loads `.env.development` ONLY in development mode — i.e. for
# `npm run -w apps/web dev` (`vite --host`), never for `vite build` (production
# mode), so nothing here is baked into the shipped tcab-web image. That image
# injects its URLs at runtime via /config.js (window.__TCAB_CONFIG__) instead;
# these VITE_* vars are only the dev server's fallback (see
# src/state/useConnections.ts: __TCAB_CONFIG__ ?? import.meta.env.VITE_* ?? …).
#
# The local service stack (backend, auth, artifacts, arena) runs on the k3d cluster
# — NOT the web console, which you now run from source with this dev server. Point
# it at the addresses `make -C deployments/local local-forward` exposes on localhost,
# so `npm run -w apps/web dev` is configured out of the box with no extra flags. The
# backend/auth CORS layers are permissive, so these cross-origin requests are allowed.
#
# To override (e.g. aim the dev console at a staging backend), copy these into a
# gitignored `.env.development.local`, which Vite loads with higher precedence.
VITE_BACKEND_URL=http://127.0.0.1:8787
VITE_AUTH_URL=http://127.0.0.1:8789
