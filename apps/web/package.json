{
  "name": "@test-cabinet/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Test Cabinet's runner/reporter console running in a browser. Shares the console UI with the Tauri app via @test-cabinet/ui; talks to a backend (catalog + published data) and a set of worker servers (execution) over HTTP.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-zone": "2.0.1",
    "@opentelemetry/core": "2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/instrumentation": "0.203.0",
    "@opentelemetry/instrumentation-fetch": "0.203.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-trace-web": "2.0.1",
    "@opentelemetry/semantic-conventions": "1.36.0",
    "@test-cabinet/run-record": "*",
    "@test-cabinet/ui": "*",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "sass": "^1",
    "typescript": "^5",
    "vite": "^6"
  }
}
