{
  "name": "@test-cabinet/edge",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The short-link resolver behind tcab.ai: turns a run's short code into its gallery page, and answers a crawler with the run's preview card.",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
