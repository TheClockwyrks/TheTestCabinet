    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@test-cabinet/share-links": "*"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
