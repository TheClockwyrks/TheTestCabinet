{
  // The workspace this checkout opens as in VS Code, with the editor set up the
  // way the gates assume, so what the editor saves is what `make gate` accepts.
  // It needs no devcontainer: opened on any machine, it applies the same
  // settings.
  //
  // See:
  // - Original mention of `vscode://schemas/`: https://stackoverflow.com/a/78117666
  // - Schema registration: https://github.com/microsoft/vscode/blob/61b3d0ab13be7dda2389f1d3e60a119c7f660cc3/src/vs/workbench/services/configuration/browser/configurationService.ts#L1304
  // - Schema ID: https://github.com/microsoft/vscode/blob/61b3d0ab13be7dda2389f1d3e60a119c7f660cc3/src/vs/workbench/services/configuration/common/configuration.ts#L22
  "$schema": "vscode://schemas/settings/workspace",
  "folders": [
    {
      "name": "Root",
      "path": ".",
    },
  ],
  // The extensions the settings below name, recommended here as well as in the
  // devcontainer so an editor opened outside it offers them too: markdownlint
  // formats Markdown the way the markdownlint gate checks it.
  "extensions": {
    "recommendations": [
      "DavidAnson.vscode-markdownlint",
      "timonwong.shellcheck",
      "yzhang.markdown-all-in-one",
    ],
  },
  "settings": {
    "editor.renderWhitespace": "boundary",
    "files.exclude": {
      // Autogenerated/default VSCode entries
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      // Custom entries
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
      // Cargo's and Vite's build output, which the format gate
      // (`.prettierignore`), the cspell gate (`cspell.json`) and the
      // markdownlint gate (`.gitignore`) all leave out.
      "**/target": true,
      "**/dist": true,
      // The environment uv builds for the `ci` project and the cache Ruff
      // keeps, which the python-lint gate's Ruff leaves out because
      // `.gitignore` names them.
      "**/.venv": true,
      "**/.ruff_cache": true,
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "markdown.extension.toc.orderedList": true,
    "shellcheck.ignorePatterns": {
      "**/.env*": true,
    },
    "workbench.browser.openLocalhostLinks": false,
    "[markdown]": {
      "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
      "editor.formatOnType": false,
      "editor.formatOnPaste": true,
      "editor.formatOnSave": true,
    },
    "[plaintext]": {
      "editor.suggest.showSnippets": false,
      "editor.suggest.showWords": false,
      "editor.acceptSuggestionOnCommitCharacter": false,
      "editor.acceptSuggestionOnEnter": "off",
    },
  },
}
