# The Test Cabinet — gallery site environment file (`@test-cabinet/site`).
#
# Copy this file to `.env.site` and fill in a real value:
#
#     cp .env.site.example .env.site
#
# The Vite build loads `.env.site` from the site project root before reading
# TCAB_SNAPSHOT_URL. Variables already exported in your shell take precedence
# over the file. On Cloudflare Pages this is set as a build environment variable
# instead of via a file.
#
# `.env.site` is gitignored; this `.env.site.example` is committed with a
# placeholder value only.

# The public R2 snapshot base URL the site fetches at *build* time and inlines
# into the static bundle. Unset builds against an empty dataset.
TCAB_SNAPSHOT_URL=https://snapshot.example.com
