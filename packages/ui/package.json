    "@test-cabinet/run-record": "*",
    "@test-cabinet/voxel-runtime": "*",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.0",
    "react-toastify": "^11.0.5",
    "react-virtuoso": "^4.18.7",
    "remark-gfm": "^4.0.1",
    "three": "~0.182.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "~0.182.0",
    "@vitejs/plugin-react": "^4",
    "jsdom": "^26",
