{
  "name": "@test-cabinet/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Shared frontend library for The Test Cabinet's GUIs: the full routed gallery application, brand-neutral presentational primitives, and the transport-agnostic backend/worker client interfaces.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./client": "./src/client/index.ts",
    "./app": "./src/app/index.ts",
    "./transport": "./src/transport/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.16",
    "@react-three/drei": "^10.7.7",
