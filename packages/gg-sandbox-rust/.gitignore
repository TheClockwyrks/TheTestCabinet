# The staged rlibs and cargo's target directory. THIS PACKAGE COMMITS NOTHING: `build.sh` writes
# the library set and its manifest into $GG_ARTIFACTS_OUT_DIR — the `OUT_DIR` of
# crates/gg-sandbox-artifacts/rust — and `signatures.sh` writes the catalogue into
# $GG_SIGNATURES_OUT_DIR, which is crates/gg's.
.build/
# The generated WIT bindings: a pure function of crates/gg/wit/gg-sandbox.wit and the pinned
# wit-bindgen release, regenerated by build.sh. A copy in the tree would be a second thing to keep
# in step with the wire.
src/bindings.rs
