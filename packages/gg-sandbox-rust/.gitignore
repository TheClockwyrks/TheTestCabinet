# The vendored `wit-bindgen` CLI, the staged rlibs and cargo's target directory. Everything this
# package COMMITS lands in crates/gg/src/sandbox/checkers/ instead.
.build/
# The generated WIT bindings: a pure function of crates/gg/wit/gg-sandbox.wit and the pinned
# wit-bindgen release, regenerated by build.sh. A copy in the tree would be a second thing to keep
# in step with the wire.
src/bindings.rs
