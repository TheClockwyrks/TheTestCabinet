{
  "name": "@test-cabinet/run-stats",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Framework-free run scoring and set-level rollups: the rules every surface that reports a Test Cabinet figure shares.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@test-cabinet/run-record": "*"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^3"
  }
}
