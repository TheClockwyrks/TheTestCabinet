# The Test Cabinet — artifact-service environment file (`tcab-artifacts`).
#
# Copy this file to `.env.artifacts` and fill in real values:
#
#     cp .env.artifacts.example .env.artifacts
#
# The artifact service reads its whole configuration from the environment
# (documented in crates/artifacts/src/config.rs). The private run-tree container and
# one public store must be named; every other variable has a default. Variables
# already exported in your shell take precedence over the file.
#
# `.env.artifacts` is gitignored; this `.env.artifacts.example` is committed with
# placeholder values only.

# Address the Axum server binds. Binds all interfaces by default because the driver
# (upload) and console (read) reach it over the cluster network. Default: 0.0.0.0:8790
#TCAB_ARTIFACTS_BIND=0.0.0.0:8790

# The private Blob container the run trees are written to (required). Against the
# Azurite emulator, name its well-known account and give its endpoint and key; with
# neither endpoint nor key the service authenticates by workload identity, as in a
# cluster.
TCAB_ARTIFACTS_BLOB_ACCOUNT=devstoreaccount1
TCAB_ARTIFACTS_BLOB_CONTAINER=run-trees
TCAB_ARTIFACTS_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
TCAB_ARTIFACTS_BLOB_KEY=REPLACE_ME

# The public dataset's store (exactly one): an Azurite container standing in for
# the public bucket, or the R2 bucket the TCAB_R2_* variables name.
TCAB_ARTIFACTS_PUBLIC_BLOB_CONTAINER=public
#TCAB_R2_ACCOUNT_ID=REPLACE_ME
#TCAB_R2_BUCKET=REPLACE_ME
#TCAB_R2_ACCESS_KEY_ID=REPLACE_ME
#TCAB_R2_SECRET_ACCESS_KEY=REPLACE_ME

# The backend it forwards a driver's per-job token to for upload auth (the backend
# is the token authority). Default: http://127.0.0.1:8787
#TCAB_BACKEND_URL=http://127.0.0.1:8787

# The Cloudflare Access application whose assertion (`Cf-Access-Jwt-Assertion`) the
# service verifies on every request through the edge: the team domain whose
# certificates sign it and the application's audience tag. Set both, or neither: with
# neither the service takes the identity from `Cf-Access-Authenticated-User-Email` as
# presented (local development), and one set alone refuses to start.
#TCAB_ACCESS_TEAM_DOMAIN=shrill-term-5c16.cloudflareaccess.com
#TCAB_ACCESS_AUDIENCE=REPLACE_ME

# The service token the backend presents to manage stored trees (prune, list).
# Unset, tree management is disabled.
#TCAB_BACKEND_SERVICE_TOKEN=REPLACE_ME

# ── Telemetry (OpenTelemetry / OTLP) ─────────────────────────────────────────
#TCAB_ENV=local
