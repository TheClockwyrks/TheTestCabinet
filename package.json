{
  "name": "the-test-cabinet",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "contracts/packages/*",
    "engines/packages/*",
    "ui-common/packages/*"
  ],
  "overrides": {
    "three": "~0.185.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @clockwyrks/run-record -w @clockwyrks/backend-api -w @clockwyrks/run-stats -w @clockwyrks/simple-2d -w @clockwyrks/structured-2d -w @clockwyrks/simple-3d -w @clockwyrks/structured-3d -w @clockwyrks/voxel-runtime -w @clockwyrks/particle-runtime -w @clockwyrks/lattice-runtime -w @clockwyrks/ui",
    "dev": "npm run dev --workspaces --if-present",
    "format": "node scripts/format-check.mjs --write",
    "format:check": "node scripts/format-check.mjs",
    "lint:docs": "npm run lint:md && npm run spell",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell lint --no-progress --cache",
    "test": "npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.0",
    "cspell": "10.2.2",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.4"
  }
}
