{
  "name": "the-test-cabinet",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "three": "~0.182.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @test-cabinet/run-record -w @test-cabinet/run-stats -w @test-cabinet/voxel-runtime -w @test-cabinet/particle-runtime",
    "build:site": "npm run build:packages && npm run build -w @test-cabinet/site",
    "dev": "npm run dev --workspaces --if-present",
    "gen:contract": "node scripts/gen-contract.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "lint:md": "markdownlint-cli2",
    "lint:specs": "npm run lint:md && npm run spell",
    "spell": "cspell lint --no-progress --cache",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "3.8.4"
  }
}
