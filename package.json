{
  "name": "the-test-cabinet",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "three": "~0.185.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @clockwyrks/run-record -w @clockwyrks/run-stats -w @clockwyrks/simple-2d -w @clockwyrks/structured-2d -w @clockwyrks/simple-3d -w @clockwyrks/structured-3d -w @clockwyrks/voxel-runtime -w @clockwyrks/particle-runtime",
    "build:site": "npm run build:packages && npm run build -w @clockwyrks/site",
    "dev": "npm run dev --workspaces --if-present",
    "gen:contract": "node scripts/gen-contract.mjs",
    "format": "node scripts/format-check.mjs --write",
    "lint": "npm run lint --workspaces --if-present && npm run lint:specs && npm run lint:format",
    "lint:format": "node scripts/format-check.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:specs": "npm run lint:md && npm run spell",
    "spell": "cspell lint --no-progress --cache",
    "test": "npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:validators": "node scripts/typecheck-validators.mjs"
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "3.8.4"
  }
}
