{
  "$comment": "Shared scoring goldens: executed by crates/core/src/review.goldens.test.rs and packages/run-stats/src/scoring.goldens.test.ts, which both reject unknown keys. Expectations are the Rust core's output. apply_score_exclusions / applyScoreExclusions: input.items is the effective checklist, input.excluded the verdict ids errata exclude; expect is the checklist with scored flags applied (compared with defaults filled in).",
  "cases": [
    {
      "name": "excluding a category excludes all its points",
      "why": "A whole-category id clears the category and every point in it.",
      "input": {
        "items": [
          {
            "id": "a",
            "weight": 1
          },
          {
            "id": "cat",
            "weight": 2,
            "subItems": [
              {
                "id": "x"
              },
              {
                "id": "y"
              }
            ]
          }
        ],
        "excluded": ["cat"]
      },
      "expect": [
        {
          "id": "a",
          "weight": 1
        },
        {
          "id": "cat",
          "weight": 2,
          "scored": false,
          "subItems": [
            {
              "id": "x",
              "scored": false
            },
            {
              "id": "y",
              "scored": false
            }
          ]
        }
      ]
    },
    {
      "name": "a composite id excludes only its point",
      "why": "The rest of the category stays scored.",
      "input": {
        "items": [
          {
            "id": "cat",
            "weight": 3,
            "subItems": [
              {
                "id": "x"
              },
              {
                "id": "y"
              }
            ]
          }
        ],
        "excluded": ["cat.y"]
      },
      "expect": [
        {
          "id": "cat",
          "weight": 3,
          "subItems": [
            {
              "id": "x"
            },
            {
              "id": "y",
              "scored": false
            }
          ]
        }
      ]
    },
    {
      "name": "excluding a whole item clears it",
      "why": "An item without points is excluded by its own id.",
      "input": {
        "items": [
          {
            "id": "a",
            "weight": 2
          },
          {
            "id": "b",
            "weight": 3
          }
        ],
        "excluded": ["b"]
      },
      "expect": [
        {
          "id": "a",
          "weight": 2
        },
        {
          "id": "b",
          "weight": 3,
          "scored": false
        }
      ]
    },
    {
      "name": "an id matching no point is ignored",
      "why": "An erratum may name a point a later checklist edit removed.",
      "input": {
        "items": [
          {
            "id": "a",
            "weight": 1
          },
          {
            "id": "b",
            "weight": 1,
            "subItems": [
              {
                "id": "x"
              }
            ]
          }
        ],
        "excluded": ["ghost", "a.x", "b.y"]
      },
      "expect": [
        {
          "id": "a",
          "weight": 1
        },
        {
          "id": "b",
          "weight": 1,
          "subItems": [
            {
              "id": "x"
            }
          ]
        }
      ]
    },
    {
      "name": "no exclusions leave the checklist as it was",
      "why": "Including a point an earlier pass already excluded.",
      "input": {
        "items": [
          {
            "id": "a",
            "weight": 1,
            "scored": false
          },
          {
            "id": "b",
            "weight": 1,
            "subItems": [
              {
                "id": "x",
                "scored": false
              }
            ]
          }
        ],
        "excluded": []
      },
      "expect": [
        {
          "id": "a",
          "weight": 1,
          "scored": false
        },
        {
          "id": "b",
          "weight": 1,
          "subItems": [
            {
              "id": "x",
              "scored": false
            }
          ]
        }
      ]
    }
  ]
}
