{
  "$comment": "Shared scoring goldens: executed by crates/core/src/review.goldens.test.rs and packages/run-stats/src/scoring.goldens.test.ts, which both reject unknown keys. Expectations are the Rust core's output. aggregate_score / aggregate_rating / aggregate_overall_grade and their aggregate* mirrors: input.scores are per-review Scores, input.ratings per-review domain ratings, input.checklists per-review verdicts.",
  "cases": [
    {
      "name": "a run with no reviews aggregates to nothing",
      "why": "The publish gate forbids it, so null is the only honest answer.",
      "input": {
        "scores": [],
        "ratings": [],
        "checklists": []
      },
      "expect": {
        "score": null,
        "rating": null,
        "overallGrade": null
      }
    },
    {
      "name": "the score is the mean and the rating and grade the worst",
      "why": "One harsh reviewer cannot be masked by a generous one.",
      "input": {
        "scores": [
          {
            "earned": 7,
            "total": 10
          },
          {
            "earned": 9,
            "total": 10
          }
        ],
        "ratings": [
          [
            {
              "domain": "play",
              "rating": "great"
            }
          ],
          [
            {
              "domain": "play",
              "rating": "scuffed"
            },
            {
              "domain": "versus",
              "rating": "flawless"
            }
          ]
        ],
        "checklists": [
          [
            {
              "id": "gfx",
              "status": "great"
            },
            {
              "id": "overall",
              "status": "incredible"
            }
          ],
          [
            {
              "id": "gfx",
              "status": "poor"
            },
            {
              "id": "overall",
              "status": "neutral"
            }
          ]
        ]
      },
      "expect": {
        "score": {
          "earned": 8,
          "total": 10,
          "reviews": 2
        },
        "rating": "scuffed",
        "overallGrade": "neutral"
      }
    },
    {
      "name": "the total is the largest across the reviews",
      "why": "Defensive: the totals agree in practice.",
      "input": {
        "scores": [
          {
            "earned": 3,
            "total": 5
          },
          {
            "earned": 4,
            "total": 6
          }
        ],
        "ratings": [[]],
        "checklists": [
          [
            {
              "id": "a",
              "status": "pass"
            }
          ],
          []
        ]
      },
      "expect": {
        "score": {
          "earned": 3.5,
          "total": 6,
          "reviews": 2
        },
        "rating": null,
        "overallGrade": null
      }
    },
    {
      "name": "a fractional mean is kept exactly",
      "why": "Both sides divide the same IEEE sum by the review count.",
      "input": {
        "scores": [
          {
            "earned": 1,
            "total": 3
          },
          {
            "earned": 2,
            "total": 3
          },
          {
            "earned": 2,
            "total": 3
          }
        ],
        "ratings": [],
        "checklists": []
      },
      "expect": {
        "score": {
          "earned": 1.6666666666666667,
          "total": 3,
          "reviews": 3
        },
        "rating": null,
        "overallGrade": null
      }
    },
    {
      "name": "a binary overall verdict is not a grade",
      "why": "Only the five graded tiers count as an overall grade.",
      "input": {
        "scores": [
          {
            "earned": 1,
            "total": 1
          }
        ],
        "ratings": [
          [
            {
              "domain": "play",
              "rating": "broken"
            }
          ]
        ],
        "checklists": [
          [
            {
              "id": "overall",
              "status": "pass"
            }
          ],
          [
            {
              "id": "overall",
              "status": "poor"
            }
          ]
        ]
      },
      "expect": {
        "score": {
          "earned": 1,
          "total": 1,
          "reviews": 1
        },
        "rating": "broken",
        "overallGrade": "poor"
      }
    }
  ]
}
