{
  "$comment": "Shared scoring goldens: executed by crates/core/src/review.goldens.test.rs and packages/run-stats/src/scoring.goldens.test.ts, which both reject unknown keys. Expectations are the Rust core's output. comparison::{automated_verdicts, automated_only_score, covered_score} and their mirrors: automatedVerdicts reads input.debugScripts, automatedOnlyScore scores input.items against them, and coveredScore scores input.items against input.verdicts.",
  "cases": [
    {
      "name": "a contract failure fails and an inconclusive or silent script is skipped",
      "why": "The failure semantics every validator-decided figure shares.",
      "input": {
        "items": [],
        "debugScripts": [
          {
            "itemId": "a",
            "verdicts": [
              {
                "id": "a",
                "pass": true
              }
            ]
          },
          {
            "itemId": "b",
            "subItemId": "x",
            "ran": false
          },
          {
            "itemId": "c",
            "ran": false,
            "preconditionUnmet": true
          },
          {
            "itemId": "d"
          }
        ],
        "verdicts": []
      },
      "expect": {
        "automatedVerdicts": [
          {
            "id": "a",
            "status": "pass"
          },
          {
            "id": "b.x",
            "status": "fail"
          }
        ],
        "automatedOnlyScore": {
          "earned": 0,
          "total": 0
        },
        "coveredScore": {
          "earned": 0,
          "total": 0
        }
      }
    },
    {
      "name": "both sides are restricted to the covered points",
      "why": "A human-only point is excluded rather than failed.",
