            "subItems": [
              {
                "id": "x"
              },
              {
                "id": "y"
              },
              {
                "id": "z"
              }
            ]
          }
        ],
        "debugScripts": [
          {
            "itemId": "cat",
            "subItemId": "x",
            "verdicts": [
              {
                "id": "cat.x",
                "pass": true
              }
            ]
          },
          {
            "itemId": "cat",
            "subItemId": "y",
            "verdicts": [
              {
                "id": "cat.y",
                "pass": false
