        "items": [
          {
            "id": "a",
            "weight": 3
          },
          {
            "id": "b",
            "weight": 2
          },
          {
            "id": "human",
            "weight": 5
          }
        ],
        "debugScripts": [
          {
            "itemId": "a",
            "verdicts": [
              {
                "id": "a",
                "pass": true
              }
            ]
          },
          {
            "itemId": "b",
            "verdicts": [
              {
                "id": "b",
                "pass": false
              }
            ]
          }
        ],
        "verdicts": [
          {
            "id": "human",
            "status": "pass"
          }
        ]
      },
      "expect": {
        "automatedVerdicts": [
          {
            "id": "a",
            "status": "pass"
          },
          {
            "id": "b",
            "status": "fail"
          }
        ],
        "automatedOnlyScore": {
          "earned": 3,
          "total": 5
        },
        "coveredScore": {
          "earned": 5,
          "total": 5
        }
      }
    },
    {
