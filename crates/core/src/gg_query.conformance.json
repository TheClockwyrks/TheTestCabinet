  "cases": [
    {
      "name": "the default document order is finished descending, ties by id, absent last",
      "why": "Rule: document order is imposed before filtering so both implementations fold in the same sequence. r1 and r2 share a finish time, so the id tiebreak is exercised; r6 has no finished timestamp and must land last rather than first.",
      "query": {},
      "expect": {
        "totalRuns": 6,
        "documentIds": [
          "r5",
          "r4",
          "r3",
          "r1",
          "r2",
          "r6"
        ]
      }
    },
    {
      "name": "an absent field fails != like every other comparison",
      "why": "Rule 1, the arm most likely to be got wrong: r5 and r6 carry no runtime at all, and the tempting reading of `!= 10` would include them.",
      "query": {
        "filter": {
          "kind": "compare",
          "field": "metric.runTimeSeconds",
          "op": "ne",
          "value": 10
        }
      },
      "expect": {
        "totalRuns": 3,
        "documentIds": [
          "r4",
          "r3",
          "r2"
        ]
      }
    },
    {
      "name": "not is the only way to reach an absent field",
      "why": "Rule 1's other half: negating the same predicate does pick up the two runs that lack the field, which is what makes the blunt comparison rule usable.",
      "query": {
        "filter": {
          "kind": "not",
          "clause": {
            "kind": "compare",
            "field": "metric.runTimeSeconds",
            "op": "eq",
            "value": 10
          }
        }
      },
      "expect": {
        "totalRuns": 5,
        "documentIds": [
          "r5",
          "r4",
          "r3",
          "r2",
          "r6"
        ]
      }
    },
    {
      "name": "an absent metric is absent, not zero",
      "why": "Rule 3. r5 is an infrastructure failure whose record carries default metrics; if the builder had flattened a zero run time it would appear here.",
      "query": {
        "filter": {
          "kind": "exists",
          "field": "metric.runTimeSeconds"
        }
      },
      "expect": {
        "totalRuns": 4,
        "documentIds": [
          "r4",
          "r3",
          "r1",
          "r2"
        ]
      }
    },
    {
      "name": "a glob matches case-insensitively",
      "why": "`:` is equality with `*` globs and no case sensitivity, which is what makes model prefix search a first-class predicate without a second operator.",
      "query": {
        "filter": {
          "kind": "compare",
          "field": "model",
          "op": "eq",
          "value": "ANTHROPIC/*"
        }
      },
      "expect": {
        "totalRuns": 3,
        "documentIds": [
          "r5",
          "r1",
          "r2"
        ]
      }
    },
    {
      "name": "an open-ended range is inclusive on the bound it names",
      "why": "`[20 to *]` must include 20 itself and must not admit the documents that lack the field.",
      "query": {
        "filter": {
          "kind": "range",
          "field": "metric.runTimeSeconds",
          "from": 20
        }
      },
      "expect": {
        "totalRuns": 3,
        "documentIds": [
          "r4",
          "r3",
          "r2"
        ]
      }
    },
    {
      "name": "an open lower bound is inclusive too",
      "why": "The mirror of the case above, so an off-by-one on either bound is caught.",
      "query": {
        "filter": {
          "kind": "range",
          "field": "metric.runTimeSeconds",
          "to": 20
        }
      },
      "expect": {
        "totalRuns": 2,
        "documentIds": [
          "r1",
          "r2"
        ]
      }
    },
    {
      "name": "or expresses what an all-AND engine could not",
      "why": "\"hung or timed out\" is the query the closed vocabulary this language replaced was structurally unable to ask.",
      "query": {
        "filter": {
          "kind": "or",
          "clauses": [
            {
              "kind": "compare",
              "field": "state",
              "op": "eq",
              "value": "hung"
            },
            {
              "kind": "compare",
              "field": "state",
              "op": "eq",
              "value": "timed_out"
            }
          ]
        }
      },
      "expect": {
        "totalRuns": 2,
        "documentIds": [
          "r4",
          "r3"
        ]
      }
    },
    {
      "name": "a limit truncates and says so",
      "why": "totalRuns must stay the unlimited count, so a limited page never makes the denominator lie.",
      "query": {
        "limit": 2
      },
      "expect": {
        "totalRuns": 6,
        "truncated": true,
        "documentIds": [
          "r5",
          "r4"
        ]
      }
    },
    {
      "name": "the total cap.* projection makes an enablement rate honest",
      "why": "Every document carries cap.compaction, including the runs that never configured it, so avg() contributes 6 of 6 and the rate is over all runs rather than over the ones that mentioned the capability.",
      "query": {
        "stats": {
          "aggs": [
            {
              "func": "avg",
              "field": "cap.compaction",
              "alias": "compaction_rate"
            },
            {
              "func": "count"
            }
          ]
        }
      },
      "expect": {
        "totalRuns": 6,
        "columns": [
          {
            "name": "compaction_rate",
            "func": "avg",
            "field": "cap.compaction"
          },
          {
            "name": "count()",
            "func": "count"
          }
        ],
        "buckets": [
          {
            "key": [],
            "n": 6,
            "values": [
              {
                "name": "compaction_rate",
                "value": 0.5,
                "contributing": 6
              },
              {
                "name": "count()",
                "value": 6,
                "contributing": 6
              }
            ]
          }
        ]
      }
    },
    {
      "name": "a sparse tool.* field reports a smaller denominator",
      "why": "tool.* is deliberately sparse, so `contributing` (2) is what tells a reader the average is over two runs and not six. Without it the 1.0 would read as \"every run had the edit tool\".",
      "query": {
        "stats": {
          "aggs": [
            {
              "func": "avg",
              "field": "tool.edit_file"
            },
            {
              "func": "count"
            }
          ]
        }
      },
      "expect": {
        "totalRuns": 6,
        "buckets": [
          {
            "key": [],
            "n": 6,
            "values": [
              {
                "name": "avg(tool.edit_file)",
                "value": 1,
                "contributing": 2
              },
              {
                "name": "count()",
                "value": 6,
                "contributing": 6
              }
            ]
          }
        ]
      }
    },
    {
      "name": "not on a sparse field finds the runs that never had the tool",
      "why": "Because tool.* is sparse, \"never offered this tool\" has to be written as a negation — and it must catch runs with no summary at all as well as runs whose summary listed other tools.",
      "query": {
        "filter": {
          "kind": "not",
          "clause": {
            "kind": "exists",
            "field": "tool.edit_file"
          }
        }
      },
      "expect": {
        "totalRuns": 4,
        "documentIds": [
          "r5",
          "r4",
          "r2",
          "r6"
        ]
      }
    },
    {
      "name": "a sum over a bucket that carried nothing is absent, not zero",
      "why": "A zero here would invent a measurement and draw a zero bar on a chart. `contributing` is 0 and the value is omitted.",
      "query": {
        "filter": {
          "kind": "compare",
          "field": "id",
          "op": "eq",
          "value": "r6"
        },
        "stats": {
          "aggs": [
            {
              "func": "sum",
              "field": "metric.runTimeSeconds"
            },
            {
              "func": "count"
            }
          ]
        }
      },
      "expect": {
        "totalRuns": 1,
        "buckets": [
          {
            "key": [],
            "n": 1,
            "values": [
              {
                "name": "sum(metric.runTimeSeconds)",
                "contributing": 0
              },
              {
                "name": "count()",
                "value": 1,
                "contributing": 1
              }
            ]
          }
        ]
      }
    },
    {
      "name": "distinct counts under the same total order as bucket keys",
      "why": "Two runs share a model, so distinct must be 4 over 6 contributing documents — and it must agree with what a group-by on the same field would produce.",
      "query": {
        "stats": {
          "aggs": [
            {
              "func": "distinct",
              "field": "model"
            },
            {
              "func": "count"
            }
          ]
        }
      },
      "expect": {
        "totalRuns": 6,
        "buckets": [
          {
            "key": [],
            "n": 6,
            "values": [
              {
                "name": "distinct(model)",
                "value": 4,
                "contributing": 6
              },
              {
                "name": "count()",
                "value": 6,
                "contributing": 6
              }
            ]
          }
        ]
      }
    },
    {
      "name": "quantiles at n=1 collapse to the single observation",
      "why": "One of the four n=1..4 cases that pin the repository's single interpolated quantile definition; at n=1 every figure is the observation itself and the interval has no width.",
      "query": {
        "filter": {
          "kind": "compare",
          "field": "id",
          "op": "eq",
          "value": "r1"
        },
        "stats": {
          "aggs": [
            {
              "func": "median",
              "field": "metric.runTimeSeconds"
            },
            {
              "func": "p90",
              "field": "metric.runTimeSeconds"
            },
            {
              "func": "p95",
              "field": "metric.runTimeSeconds"
            },
            {
              "func": "dist",
              "field": "metric.runTimeSeconds"
            }
          ]
        }
      },
      "expect": {
        "totalRuns": 1,
        "buckets": [
          {
            "key": [],
            "n": 1,
            "values": [
              {
                "name": "median(metric.runTimeSeconds)",
                "value": 10,
                "contributing": 1
              },
              {
                "name": "p90(metric.runTimeSeconds)",
                "value": 10,
                "contributing": 1
              },
              {
                "name": "p95(metric.runTimeSeconds)",
                "value": 10,
                "contributing": 1
              },
              {
                "name": "dist(metric.runTimeSeconds)",
                "contributing": 1,
                "distribution": {
                  "n": 1,
                  "min": 10,
                  "q1": 10,
                  "median": 10,
                  "q3": 10,
                  "max": 10,
                  "mean": 10
                }
              }
            ]
          }
        ]
      }
    },
