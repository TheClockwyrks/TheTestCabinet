{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Test Cabinet",
  "version": "0.0.0",
  "identifier": "dev.thetestcabinet.desktop",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -w @test-cabinet/desktop",
    "beforeBuildCommand": "npm run build -w @test-cabinet/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Test Cabinet",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http: https: tcab-tournament:",
        "media-src": "'self' data: blob: http: https: tcab-tournament:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "frame-src": "'self' http: https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
