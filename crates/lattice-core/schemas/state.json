{
  "$defs": {
    "AssemblerState": {
      "description": "An assembler's retained state. Buffers are item-id → count maps.",
      "properties": {
        "craft_left": {
          "description": "Ticks remaining in the current craft (`0` when not crafting).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "inputs": {
          "additionalProperties": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "description": "The input buffer: item id → count (empty map when nothing buffered).",
          "type": "object"
        },
        "output": {
          "additionalProperties": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "description": "The output buffer: item id → count.",
          "type": "object"
        }
      },
      "required": [
        "inputs",
        "output",
        "craft_left"
      ],
      "type": "object"
    },
    "BeltItem": {
      "description": "One item on a belt lane, as the JSON output spells it.",
      "properties": {
        "item": {
          "description": "The item id.",
          "type": "string"
        },
        "pos": {
          "description": "Position in units from the lane's output end (`0..TILE`).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pos",
        "item"
      ],
      "type": "object"
    },
    "BeltState": {
      "description": "One belt's two lanes, each listing its items from the output end backward\n(ascending `pos`).",
      "properties": {
        "left": {
          "description": "The left lane (relative to the belt's direction of travel).",
          "items": {
            "$ref": "#/$defs/BeltItem"
          },
          "type": "array"
        },
        "right": {
          "description": "The right lane.",
          "items": {
            "$ref": "#/$defs/BeltItem"
          },
          "type": "array"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "type": "object"
    },
    "EntityState": {
      "description": "One entity's state, externally tagged so the array stays parallel to the\nscenario's `entities` (`{ \"belt\": {...} }`, `{ \"sink\": {...} }`, …).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "belt": {
              "$ref": "#/$defs/BeltState"
            }
          },
          "required": [
            "belt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "splitter": {
              "$ref": "#/$defs/SplitterState"
            }
          },
          "required": [
            "splitter"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "inserter": {
              "$ref": "#/$defs/InserterState"
            }
          },
          "required": [
            "inserter"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assembler": {
              "$ref": "#/$defs/AssemblerState"
            }
          },
          "required": [
            "assembler"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A source holds no item state at rest; `emit_phase` is `tick % period`, so\na mid-period snapshot is self-describing.",
          "properties": {
            "source": {
              "properties": {
                "emit_phase": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "emit_phase"
              ],
              "type": "object"
            }
          },
          "required": [
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sink": {
              "$ref": "#/$defs/SinkState"
            }
          },
          "required": [
            "sink"
          ],
          "type": "object"
        }
      ]
    },
    "InserterPhase": {
      "description": "An inserter's swing-arm phase.",
      "oneOf": [
        {
          "const": "idle",
          "description": "Empty-handed, waiting to pick up.",
          "type": "string"
        },
        {
          "const": "swing",
          "description": "Holding an item, counting the swing down.",
          "type": "string"
        }
      ]
    },
    "InserterState": {
      "description": "An inserter's retained state.",
      "properties": {
        "held": {
          "description": "The held item, present only while swinging.",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/InserterPhase",
          "description": "`idle` or `swing`."
        },
        "swing_left": {
          "description": "Ticks remaining in the current swing (`0` while idle).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "swing_left"
      ],
      "type": "object"
    },
    "SinkState": {
      "description": "A sink's retained state: per-item running consumed counts.",
      "properties": {
        "consumed": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Item id → total consumed.",
          "type": "object"
        }
      },
      "required": [
        "consumed"
      ],
      "type": "object"
    },
    "Snapshot": {
      "description": "The complete canonical state at one snapshot tick.",
      "properties": {
        "checksum": {
          "description": "The FNV-1a checksum over the [canonical bytes](canonical_bytes) of this\nsnapshot, formatted `fnv1a64:%016x`. This is the validator's comparison\nkey.",
          "type": "string"
        },
        "entities": {
          "description": "The per-entity state, in scenario placement order.",
          "items": {
            "$ref": "#/$defs/EntityState"
          },
          "type": "array"
        },
        "tick": {
          "description": "The tick this snapshot was taken at.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "checksum",
        "entities"
      ],
      "type": "object"
    },
    "SplitterState": {
      "description": "A splitter's retained state. A base splitter holds **no items between ticks**\n(it transfers within the tick it pulls), so only the two round-robin cursors\nare retained.",
      "properties": {
        "rr_in": {
          "description": "Which input the splitter pulls from next (`0` or `1`).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "rr_out": {
          "description": "Which of the four output lanes the splitter pushes to next, in `0..4`:\n`belt = rr_out & 1`, `lane = rr_out >> 1` (`0` = left, `1` = right).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rr_in",
        "rr_out"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/Snapshot"
  },
  "title": "Array_of_Snapshot",
  "type": "array"
}
