{
  "$defs": {
    "BoardView": {
      "description": "The static board view embedded in every observation.",
      "properties": {
        "border_x": {
          "description": "First column belonging to Blue's half (matches the engine's `border_x`).",
          "format": "int32",
          "type": "integer"
        },
        "height": {
          "format": "int32",
          "type": "integer"
        },
        "walls": {
          "description": "Blocked tiles, static for the match, as `[x, y]` pairs.",
          "items": {
            "items": {
              "format": "int32",
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "width": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "border_x",
        "walls"
      ],
      "type": "object"
    },
    "EnemyAgentView": {
      "description": "One of the opposing colony's agents. The same fields minus `can_move_this_tick`\n(a controller does not drive enemies, so their cadence is not exposed).",
      "properties": {
        "carrying": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "immune_ticks": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "role",
        "carrying",
        "immune_ticks"
      ],
      "type": "object"
    },
    "JellyView": {
      "description": "A royal-jelly node in the observation.",
      "properties": {
        "active": {
          "description": "Always `true` in the list (consumed nodes are dropped from it), but kept\nexplicit to match architecture.md's shape and leave room for a future\nrecharge variant.",
          "type": "boolean"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "active"
      ],
      "type": "object"
    },
    "OwnAgentView": {
      "description": "One of the controller's *own* agents, with the carry-weight cadence\npre-computed so the controller never re-derives it.",
      "properties": {
        "can_move_this_tick": {
          "description": "Whether this agent may move this tick under carry-weight (see\n[`crate::state::Agent::can_move_this_tick`]). A move submitted for an\nagent reading `false` is a no-op.",
          "type": "boolean"
        },
        "carrying": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "immune_ticks": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "x": {
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "role",
        "carrying",
        "immune_ticks",
        "can_move_this_tick"
      ],
      "type": "object"
    },
    "Role": {
      "description": "The role an agent currently has, derived from the half it stands on.",
      "oneOf": [
        {
          "const": "soldier",
          "description": "On its own half: a defender that can tag enemy raiders.",
          "type": "string"
        },
        {
          "const": "raider",
          "description": "On the enemy half: a forager that eats caches and carries the load home.",
          "type": "string"
        }
      ]
    },
    "ScoreView": {
      "description": "Banked score, as the observation spells it (`{ \"red\": .., \"blue\": .. }`).",
      "properties": {
        "blue": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "red": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "red",
        "blue"
      ],
      "type": "object"
    },
    "SeedsRemaining": {
      "description": "Remaining (un-banked-away) seed totals per half, the sweep-progress signal.",
      "properties": {
        "blue_half": {
          "description": "Seeds still to be banked away from Blue's half (what Red must sweep).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "red_half": {
          "description": "Seeds still to be banked away from Red's half (what Blue must sweep).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "red_half",
        "blue_half"
      ],
      "type": "object"
    },
    "Team": {
      "description": "Which colony a tile or agent belongs to. Red holds the west half, Blue the\neast; an agent's *role* (soldier vs. raider) is derived from the half it\nstands on, not from the colony it belongs to — see [`crate::state`].",
      "oneOf": [
        {
          "const": "red",
          "description": "The west colony (lower columns).",
          "type": "string"
        },
        {
          "const": "blue",
          "description": "The east colony (higher columns).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The per-tick observation handed to one team's controller. Fully observable in\nv1 (no fog) — a deliberate first-case simplification.",
  "properties": {
    "board": {
      "$ref": "#/$defs/BoardView"
    },
    "enemies": {
      "description": "The opposing colony's three agents.",
      "items": {
        "$ref": "#/$defs/EnemyAgentView"
      },
      "type": "array"
    },
    "jelly": {
      "description": "Active royal-jelly nodes.",
      "items": {
        "$ref": "#/$defs/JellyView"
      },
      "type": "array"
    },
    "my_agents": {
      "description": "This team's three agents.",
      "items": {
        "$ref": "#/$defs/OwnAgentView"
      },
      "type": "array"
    },
    "score": {
      "$ref": "#/$defs/ScoreView"
    },
    "seeds": {
      "description": "Every uneaten cache (including dropped, recoverable ones) on the board.",
      "items": {
        "items": {
          "format": "int32",
          "type": "integer"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "type": "array"
    },
    "seeds_remaining": {
      "$ref": "#/$defs/SeedsRemaining"
    },
    "team": {
      "$ref": "#/$defs/Team",
      "description": "Which colony this controller drives."
    },
    "tick": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "timestep_ms": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "tick",
    "timestep_ms",
    "team",
    "board",
    "score",
    "seeds_remaining",
    "my_agents",
    "enemies",
    "seeds",
    "jelly"
  ],
  "title": "World",
  "type": "object"
}
