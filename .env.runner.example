# The Test Cabinet — runner environment file (CLI `tcab` + desktop app).
#
# Copy this file to `.env.runner` and fill in real values:
#
#     cp .env.runner.example .env.runner
#
# Both the `tcab` CLI and the desktop app load `.env.runner` on startup (with a
# legacy `.env` as a fallback), searching the working directory and its parents.
# Variables already exported in your shell take precedence over the file, so you
# can still override a single key on the command line.
#
# `.env.runner` is gitignored; this `.env.runner.example` is committed with
# placeholder values only. Never put a real key in `.env.runner.example`.

# ── Harness API keys ─────────────────────────────────────────────────────────
#
# You only need the key for the harness you intend to run — each harness reads a
# specific variable:
#
#   claude                         -> ANTHROPIC_API_KEY
#   codex                          -> OPENAI_API_KEY
#   cline, goose, kilo, opencode,  -> OPENROUTER_API_KEY
#   pi
#   antigravity                    -> (no API key supported)

# Anthropic Claude Code (`--harness claude`).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Codex (`--harness codex`). Exported as OPENAI_API_KEY on the host; the
# CLI injects it into the run container as CODEX_API_KEY, which `codex exec`
# reads.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter-backed harnesses (`--harness cline|goose|kilo|opencode|pi`).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend ──────────────────────────────────────────────────────────────────

# The backend the runner resolves definitions from and publishes runs to. Leave
# unset to resolve from a local `test-cases/` checkout (offline development);
# publishing is then disabled.
#TCAB_BACKEND_URL=https://backend.example.com

# ── Publishing release credentials ───────────────────────────────────────────
#
# These are NOT read by tcab itself. Publishing shells out to the `gh` and
# `wrangler` CLIs, and those tools read these variables from the environment.

# GitHub token used by `gh` to create and push the per-run source repositories
# (`GH_TOKEN` also works).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare API token used by `wrangler` to deploy the per-run playable builds
# to Cloudflare Pages. Needs the "Pages: Edit" permission.
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Publish target (per-run repo owner + Pages project) ──────────────────────
#
# The GitHub org the per-run source repos are created under, and the Cloudflare
# Pages project the per-run builds deploy to. The defaults are shown; override
# only if you publish into a different org/project.
#TCAB_GITHUB_ORG=TheClockwyrks
#TCAB_PAGES_PROJECT=test-cabinet-runs

# ── Optional runner-side overrides ───────────────────────────────────────────
#
# All optional; defaults are shown. Uncomment to override.

# Container runtime used to execute runs (auto-detected: podman, then docker).
#TCAB_CONTAINER_RUNTIME=podman

# Directory run records (and collected implementations) are written under.
#TCAB_OUT_DIR=runs

# Staging directory a run bind-mounts its seeded repository from. Defaults to
# `~/.tcab` (a path the container runtime's VM shares on macOS/Windows).
#TCAB_WORK_DIR=~/.tcab

# Local catalog root used for no-backend resolution.
#TCAB_TEST_CASES_DIR=test-cases

# Model catalog root.
#TCAB_MODELS_DIR=models

# Explicit path to the bundled browser-driver script (for reference rendering
# and captures), used when running from a directory the defaults do not cover.
#TCAB_BROWSER_DRIVER=packages/browser-driver/driver.mjs

# ── Telemetry (OpenTelemetry / OTLP) ─────────────────────────────────────────
#
# Telemetry is OPT-IN. With OTEL_EXPORTER_OTLP_ENDPOINT unset (the default), the
# `tcab` CLI and the desktop app log to stdout exactly as before — no exporter,
# no collector needed. Set the endpoint to export traces, metrics, and logs over
# OTLP/HTTP.
#
# The CLI and desktop app run on the HOST, so they reach the local Grafana LGTM
# stack at localhost against the ports the devcontainer publishes. (An
# in-container process would use http://lgtm:4318 instead — see
# .devcontainer/docker-compose.yml.)
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The binaries always export over HTTP/protobuf; this is the SDK default when
# the endpoint is the :4318 HTTP port, so it normally needs no override.
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTel service.name. Defaults to the value each binary seeds (`tcab` for the
# CLI, `tcab-desktop` for the desktop app); uncomment only to override.
#OTEL_SERVICE_NAME=tcab

# Sets the `deployment.environment.name` resource attribute. Default: local
#TCAB_ENV=local
