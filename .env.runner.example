# The Test Cabinet — client environment file (CLI `tcab`).
#
# Copy this file to `.env.runner` and fill in real values:
#
#     cp .env.runner.example .env.runner
#
# The `tcab` CLI loads `.env.runner` on startup (with a
# legacy `.env` as a fallback), searching the working directory and its parents.
# Variables already exported in your shell take precedence over the file, so you
# can still override a single key on the command line.
#
# `.env.runner` is gitignored; this `.env.runner.example` is committed with
# placeholder values only. Never put a real key in `.env.runner.example`.
#
# NOTE: the CLI operates on definitions and launches nothing: it validates a
# tree, analyzes its code, captures and publishes a case's references, ingests
# definitions into a backend, and inspects what a run would seed and prompt. A
# run is launched from the console and executed by a driver in the cluster, so
# the CLI needs NO host container runtime and NO harness API key of its own.

# ── Backend ──────────────────────────────────────────────────────────────────

# The backend a command resolves definitions from when it does not read the
# local checkout, and the one `tcab ingest` writes definitions into. For local
# development, point it at the forwarded k3d backend (see
# https://github.com/TheClockwyrks/TheTestCabinet/blob/master/deployments/local/Makefile
# and the "Running" docs); a deployment uses its own backend URL.
TCAB_BACKEND_URL=http://127.0.0.1:8787

# The Access credential the client presents to a deployed environment's edge on
# every request (https://docs.testcabinet.ai/quickstarts/setup/sign-in/). A person
# sets a user token from `cloudflared access token --app <origin>`; automation sets
# the service token pair, both halves. With none set, the client sends the local
# stack's identity, dev@local.
#TCAB_ACCESS_TOKEN=REPLACE_ME
#TCAB_ACCESS_CLIENT_ID=REPLACE_ME
#TCAB_ACCESS_CLIENT_SECRET=REPLACE_ME

# The backend's shared service token, for a backend reached directly rather than
# through the edge (a bare process, or `kubectl port-forward`); `tcab ingest`
# presents it.
#TCAB_BACKEND_SERVICE_TOKEN=REPLACE_ME

# ── Optional client-side overrides ───────────────────────────────────────────
#
# All optional; defaults are shown. Uncomment to override.

# Local catalog root, read by the commands that take a definition from the
# checkout (`validate`, `seed`, `prompt`, `capture-baselines`,
# `publish-reference`, `publish-asset-reference`).
#TCAB_TEST_CASES_DIR=test-cases

# Cold-storage root that `capture-baselines` writes a version's baseline media
# under. Defaults to `cold-storage/` beside the catalog's `test-cases/`.
#TCAB_COLD_STORAGE_DIR=cold-storage

# Explicit path to the bundled browser-driver script (used by `validate` and
# `capture-baselines`), when running from a directory the defaults do not cover.
#TCAB_BROWSER_DRIVER=packages/browser-driver/driver.mjs

# ── Telemetry (OpenTelemetry / OTLP) ─────────────────────────────────────────
#
# Telemetry is OPT-IN. With OTEL_EXPORTER_OTLP_ENDPOINT unset (the default), the
# `tcab` CLI logs to stdout — no exporter,
# no collector needed. Set the endpoint to export traces, metrics, and logs over
# OTLP/HTTP.
#
# The local Grafana LGTM stack runs IN THE k3d CLUSTER (deployments/k8s/
# components/observability), not the devcontainer. The CLI runs outside that
# cluster, so forward the in-cluster collector to localhost with
# `make -C deployments/local local-grafana` and point it there.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The binaries always export over HTTP/protobuf; this is the SDK default when
# the endpoint is the :4318 HTTP port, so it normally needs no override.
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTel service.name. Defaults to the value the binary seeds (`tcab` for the
# CLI); uncomment only to override.
#OTEL_SERVICE_NAME=tcab

# Sets the `deployment.environment.name` resource attribute. Default: local
#TCAB_ENV=local
