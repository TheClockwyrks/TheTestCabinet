{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Rgba": {
      "description": "Color as `#rrggbb` or `#rrggbbaa` hex.",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "type": "string"
    }
  },
  "description": "A single drawing operation the model issues through the `draw` binary.\n\nCoordinates are signed so a shape may be placed partially off-canvas (the off-canvas portion is clipped); sizes and radii are unsigned. Operations **replace** the pixels they touch rather than alpha-compositing, keeping regeneration an exact, order-only function of the log.",
  "oneOf": [
    {
      "description": "Flood the entire canvas with one color, discarding everything drawn so far. Useful as a first call to lay down a base.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The fill color."
        },
        "op": {
          "enum": [
            "fill_background"
          ],
          "type": "string"
        }
      },
      "required": [
        "color",
        "op"
      ],
      "type": "object"
    },
    {
      "description": "Set a single pixel.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The pixel color."
        },
        "op": {
          "enum": [
            "set_pixel"
          ],
          "type": "string"
        },
        "x": {
          "description": "Column (0 at the left).",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "Row (0 at the top).",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "color",
        "op",
        "x",
        "y"
      ],
      "type": "object"
    },
    {
      "description": "Fill an axis-aligned rectangle. `(x, y)` is the top-left corner.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The fill color."
        },
        "height": {
          "description": "Height in pixels.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "op": {
          "enum": [
            "fill_rect"
          ],
          "type": "string"
        },
        "width": {
          "description": "Width in pixels.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "x": {
          "description": "Left edge column.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "Top edge row.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "color",
        "height",
        "op",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    {
      "description": "Draw the 1px outline of an axis-aligned rectangle.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The outline color."
        },
        "height": {
          "description": "Height in pixels.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "op": {
          "enum": [
            "stroke_rect"
          ],
          "type": "string"
        },
        "width": {
          "description": "Width in pixels.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "x": {
          "description": "Left edge column.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "Top edge row.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "color",
        "height",
        "op",
        "width",
        "x",
        "y"
      ],
      "type": "object"
    },
    {
      "description": "Draw a 1px line between two points (inclusive of both endpoints).",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The line color."
        },
        "op": {
          "enum": [
            "line"
          ],
          "type": "string"
        },
        "x0": {
          "description": "Start column.",
          "format": "int64",
          "type": "integer"
        },
        "x1": {
          "description": "End column.",
          "format": "int64",
          "type": "integer"
        },
        "y0": {
          "description": "Start row.",
          "format": "int64",
          "type": "integer"
        },
        "y1": {
          "description": "End row.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "color",
        "op",
        "x0",
        "x1",
        "y0",
        "y1"
      ],
      "type": "object"
    },
    {
      "description": "Fill a disc centered at `(cx, cy)` with radius `r`.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The fill color."
        },
        "cx": {
          "description": "Center column.",
          "format": "int64",
          "type": "integer"
        },
        "cy": {
          "description": "Center row.",
          "format": "int64",
          "type": "integer"
        },
        "op": {
          "enum": [
            "fill_circle"
          ],
          "type": "string"
        },
        "r": {
          "description": "Radius in pixels.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "color",
        "cx",
        "cy",
        "op",
        "r"
      ],
      "type": "object"
    },
    {
      "description": "Draw the 1px outline of a circle centered at `(cx, cy)` with radius `r`.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The outline color."
        },
        "cx": {
          "description": "Center column.",
          "format": "int64",
          "type": "integer"
        },
        "cy": {
          "description": "Center row.",
          "format": "int64",
          "type": "integer"
        },
        "op": {
          "enum": [
            "stroke_circle"
          ],
          "type": "string"
        },
        "r": {
          "description": "Radius in pixels.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "color",
        "cx",
        "cy",
        "op",
        "r"
      ],
      "type": "object"
    },
    {
      "description": "Replace the contiguous, 4-connected region of pixels sharing the start pixel's current color with a new color. No-op if the start is off-canvas or already the target color.",
      "properties": {
        "color": {
          "allOf": [
            {
              "$ref": "#/definitions/Rgba"
            }
          ],
          "description": "The replacement color."
        },
        "op": {
          "enum": [
            "flood_fill"
          ],
          "type": "string"
        },
        "x": {
          "description": "Seed column.",
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "description": "Seed row.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "color",
        "op",
        "x",
        "y"
      ],
      "type": "object"
    },
    {
      "description": "Mirror the columns left of `axis_x` onto the columns to its right, reflecting across the vertical line between column `axis_x - 1` and column `axis_x`. The single highest-leverage op for a left/right-symmetric sprite.",
      "properties": {
        "axis_x": {
          "description": "The mirror axis: columns `0..axis_x` are copied onto `axis_x..`.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "op": {
          "enum": [
            "mirror_horizontal"
          ],
          "type": "string"
        }
      },
      "required": [
        "axis_x",
        "op"
      ],
      "type": "object"
    }
  ],
  "title": "Operation"
}
