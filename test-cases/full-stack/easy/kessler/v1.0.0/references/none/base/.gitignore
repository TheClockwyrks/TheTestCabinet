# Dependencies — reinstalled with `npm ci`; never committed. The particle
# playback library, `@test-cabinet/particle-runtime`, is resolved from the
# repository's own `packages/` through a relative `file:` dependency that npm
# installs as a symlink, so nothing of it is written here.
node_modules/

# Production build output — produced by `npm run build`. Anchored to this
# project's root so the patterns name only its own output.
/dist/
/build/
/out/

# Coverage reports — produced by `npm test`.
coverage/

# Asset-authoring scratch. Only the finished PNG, `.wav`, and `system.json` files
# under `assets/` are committed, never the intermediate configuration, action log,
# or preview files an asset tool leaves beside what it produced.
assets/**/*.config.json
assets/**/*.actions.json
assets/**/*.preview.png
assets/**/*.preview.gif

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log
