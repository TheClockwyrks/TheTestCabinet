{
  "name": "volute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volute — a geothermal pump hall where mineral cores ride a channel toward the intake, built on the Simple 2D engine, running entirely in the browser, whose art, effects, and audio the build produces itself.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/particle-runtime": "file:../../../../../../../../packages/particle-runtime",
    "@clockwyrks/simple-2d": "file:../../../../../../../../packages/simple-2d",
    "ts-essentials": "^10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/canvas": "^0.1",
    "@types/node": "^25.9.5",
    "@vitest/coverage-istanbul": "^3",
    "eslint": "^9",
    "playwright": "^1.61.0",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
