# Dependencies — reinstalled with `npm ci`; never committed.
node_modules/

# Production build output — produced by `npm run build`. Every pattern here is
# ANCHORED to the repository root on purpose: the particle runtime is vendored
# into this repository at `.tcab/packages/@test-cabinet/particle-runtime/`,
# prebuilt, with its own `dist/` committed alongside the seed. An unanchored
# `dist/` would match that directory too and leave the build unable to resolve
# it.
/dist/
/build/
/out/

# Coverage reports — produced by `npm test`.
coverage/

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log
