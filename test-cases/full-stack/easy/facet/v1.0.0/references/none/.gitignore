# Dependencies — reinstalled with `npm ci`; never committed.
node_modules/

# Production build output — produced by `npm run build`.
dist/
build/
out/

# Coverage reports — produced by `npm test`.
coverage/

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log

# Case validators, staged in by `tcab validate` (and by hand when checking a
# reference against them). Produced, never authored here: the authored copy is
# the case's own `validation/<engine>/`.
validation/
