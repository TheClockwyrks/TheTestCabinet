{
  "name": "facet-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Facet — the pure game core shared by the three reference builds, plus the harness that type-checks, lints, formats and tests it on its own.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
