{
  "name": "facet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Facet — a match game of cut stones that crack under the strain of their neighbors, whose art, effects, and audio the build produces itself, running entirely in the browser, on no engine.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/particle-runtime": "file:./.vendor/packages/@clockwyrks/particle-runtime"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@types/node": "^26",
    "@vitest/coverage-istanbul": "^5",
    "eslint": "^10",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
