{
  "name": "facet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Facet — a match game of cut stones played on a lit gem board, built on the Structured 2D engine, that runs entirely in the browser and produces its own art, effects, and sound.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/structured-2d": "file:./.vendor/engine/@clockwyrks/structured-2d",
    "@clockwyrks/particle-runtime": "file:./.vendor/packages/@clockwyrks/particle-runtime"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/canvas": "^0.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "^3",
    "eslint": "^9",
    "playwright": "^1.61.0",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
