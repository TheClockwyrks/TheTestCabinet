# Dependencies — reinstalled with `npm ci`; never committed.
node_modules/

# Production build output — produced by `npm run build`. Every pattern here is
# ANCHORED to the repository root on purpose: the engine is vendored into this
# repository at `.vendor/engine/@clockwyrks/structured-2d/`, and the particle
# runtime beside it at `.vendor/packages/@clockwyrks/particle-runtime/`, both
# prebuilt, with their own `dist/` committed with the seed. An unanchored
# `dist/` would match those directories too and leave the build unable to
# resolve them.
/dist/
/build/
/out/

# Coverage reports — produced by `npm test`.
coverage/

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log
