{
  "name": "deepcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deepcore — a subterranean dig-and-build game built on the Structured 2D engine, running entirely in the browser, whose art, animation, effects, and audio the build produces itself.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/particle-runtime": "file:./.vendor/packages/@clockwyrks/particle-runtime",
    "@clockwyrks/structured-2d": "file:./.vendor/engine/@clockwyrks/structured-2d"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/canvas": "^0.1",
    "@vitest/coverage-istanbul": "^3",
    "eslint": "^9",
    "playwright": "^1.61.0",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
