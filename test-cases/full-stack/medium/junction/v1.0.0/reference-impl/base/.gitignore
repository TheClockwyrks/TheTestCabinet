# Dependencies — reinstalled with `npm ci`; never committed.
node_modules/

# Rust build artifacts for the wasm simulation core (`sim-core/`). The COMPILED wasm build
# input lives in `src/sim-core-pkg/` (committed, consumed as-is by `npm run build`); the
# `target/` it is compiled from is not committed. See scripts/build-wasm.sh.
sim-core/target/

# Production build output — produced by `npm run build`. Anchored to the project
# root so the committed, vendored `vendor/particle-runtime/dist` is NOT ignored.
/dist/
/build/
/out/

# The repo-root .gitignore ignores any dir named `dist` anywhere; re-include the
# vendored, prebuilt particle-runtime output so `npm ci` can resolve it on a fresh
# checkout (it is the library's committed dist, not build output of this project).
!vendor/particle-runtime/dist/
!vendor/particle-runtime/dist/**

# Asset-authoring scratch — the intermediate action logs and previews the on-PATH
# tools write while producing an asset. Only the finished PNG / .wav / system.json
# files under assets/ are committed, never the .config.json / .actions.json / the
# *.preview.* files a tool leaves beside them.
assets/**/*.config.json
assets/**/*.actions.json
assets/**/*.preview.png
assets/**/*.preview.gif

# Proof-capture scratch — Playwright's per-run video working dir. The finished
# proof/ artifacts are committed; this intermediate dir is not.
scripts/.video/

# Logs.
*.log
