# Dependencies — reinstalled with `npm ci`; never committed.
node_modules/

# Production build output — produced by `npm run build`. Every pattern here is
# ANCHORED to the repository root on purpose: the engine is vendored into this
# repository at `.tcab/engine/@test-cabinet/simple-2d/` and the particle runtime
# at `.tcab/packages/@test-cabinet/particle-runtime/`, both prebuilt, and both
# have their own `dist/` committed with the seed. An unanchored `dist/` would
# match those directories too and leave the build unable to resolve either.
/dist/
/build/
/out/

# Coverage reports — produced by `npm test`.
coverage/

# Asset-authoring scratch. Only the finished PNG, `.wav`, `.mid`, and
# `system.json` files under `assets/` are committed, never the intermediate
# configuration, action log, or preview files an asset tool leaves beside what it
# produced.
assets/**/*.config.json
assets/**/*.actions.json
assets/**/*.preview.png
assets/**/*.preview.gif

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log
