{
  "name": "gantry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gantry — a 3D crane-building puzzle driven by an instruction tape under a structural simulation, built on the Structured 3D engine, that runs entirely in the browser.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/structured-3d": "file:./.vendor/engine/@clockwyrks/structured-3d",
    "three": "~0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/canvas": "^1",
    "@types/three": "~0.182.0",
    "@vitest/coverage-istanbul": "^3",
    "eslint": "^9",
    "playwright": "^1.61.0",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
