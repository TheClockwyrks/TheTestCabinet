# Dependencies — reinstalled with `npm ci`; never committed.
node_modules/

# Production build output — produced by `npm run build`. Every pattern here is
# ANCHORED to the repository root on purpose: the engine is vendored into this
# repository under `.tcab/`, prebuilt, and its own `dist/` directory is
# committed with the seed. An unanchored `dist/` would match that too and leave
# the build unable to resolve the package.
/dist/
/build/
/out/

# Coverage reports — produced by `npm test`.
coverage/

# Asset-authoring scratch. Only the finished `.glb`, `.wav`, and `.mid` files
# under `assets/` are committed, never the intermediate configuration, action
# log, or preview files an asset tool leaves beside what it produced.
assets/**/*.config.json
assets/**/*.actions.json
assets/**/*.preview.png
assets/**/*.preview.gif

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log
