{
  "name": "gantry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gantry — a 3D crane-building puzzle driven by an instruction tape under a structural simulation, built on the Simple 3D engine, that runs entirely in the browser.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/simple-3d": "file:../../../../../../../packages/simple-3d",
    "three": "~0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@types/three": "~0.185.0",
    "@vitest/coverage-istanbul": "^5",
    "eslint": "^10",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
