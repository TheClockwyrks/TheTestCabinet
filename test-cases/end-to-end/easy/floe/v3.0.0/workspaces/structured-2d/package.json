{
  "name": "floe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Floe — a single-screen crossing game hunted by a polar bear, built on the Structured 2D engine, that runs entirely in the browser.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/structured-2d": "file:./.vendor/engine/@clockwyrks/structured-2d"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@types/node": "^26",
    "@vitest/coverage-istanbul": "^5",
    "eslint": "^10",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
