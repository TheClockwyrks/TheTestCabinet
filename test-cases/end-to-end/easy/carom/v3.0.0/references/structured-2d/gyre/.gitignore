# Dependencies — reinstalled with `npm ci`; never committed. The engine,
# `@clockwyrks/structured-2d`, is resolved from the repository's own
# `packages/structured-2d` through a relative `file:` dependency that npm
# installs as a symlink, so nothing of it is written here.
node_modules/

# Production build output — produced by `npm run build`. Anchored to this
# project's root so the patterns name only its own output.
/dist/
/build/
/out/

# Coverage reports — produced by `npm test`.
coverage/

# Playwright verification scratch.
test-results/
playwright-report/

# Logs.
*.log

# Scratch that `tcab validate --implementation` writes beside the build.
.vendor/
