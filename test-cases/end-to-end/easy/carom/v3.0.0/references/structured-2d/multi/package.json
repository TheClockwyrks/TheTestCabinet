{
  "name": "carom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Carom (Multi-ball) — a top-down paddle duel played with three independent balls, built on the Structured 2D engine.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@test-cabinet/structured-2d": "file:../../../../../../../../packages/structured-2d"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@vitest/coverage-istanbul": "^4",
    "eslint": "^10",
    "playwright": "^1.62.1",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4"
  }
}
