{
  "name": "carom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Carom (Gyre) — a neon top-down paddle duel with swaying, spinning obstacles, built on the Simple 2D engine.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/simple-2d": "file:../../../../../../../../packages/simple-2d",
    "ts-essentials": "^10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@vitest/coverage-istanbul": "^5",
    "eslint": "^10",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
