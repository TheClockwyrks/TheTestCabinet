{
  "name": "spectra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spectra (Overload) — a fixed-position formation shooter whose two-band polarity is both cannon and shield, and whose wrong-band shots charge a drone toward an overload, built on the Structured 2D engine.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/particle-runtime": "file:../../../../../../../../packages/particle-runtime",
    "@clockwyrks/run-record": "file:../../../../../../../../packages/run-record",
    "@clockwyrks/structured-2d": "file:../../../../../../../../packages/structured-2d"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@vitest/coverage-istanbul": "^5",
    "eslint": "^10",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
