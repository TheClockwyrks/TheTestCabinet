{
  "name": "spectra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spectra — a fixed-position formation shooter with two-band polarity combat, built on the Simple 2D engine, that runs entirely in the browser.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@clockwyrks/particle-runtime": "file:./.vendor/packages/@clockwyrks/particle-runtime",
    "@clockwyrks/simple-2d": "file:./.vendor/engine/@clockwyrks/simple-2d",
    "ts-essentials": "^10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@napi-rs/canvas": "^1",
    "@vitest/coverage-istanbul": "^5",
    "eslint": "^10",
    "playwright": "^1.63.0",
    "prettier": "^3",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5"
  }
}
