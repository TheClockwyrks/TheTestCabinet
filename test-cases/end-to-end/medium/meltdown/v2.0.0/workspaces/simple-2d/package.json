{
  "name": "meltdown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meltdown — an open-field tower defense where the towers are the walls and every emitter fires harder the hotter it runs, built on the Simple 2D engine, that runs entirely in the browser.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@test-cabinet/simple-2d": "file:./.tcab/engine/@test-cabinet/simple-2d",
    "ts-essentials": "^10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@napi-rs/canvas": "^1",
    "@vitest/coverage-istanbul": "^3",
    "eslint": "^9",
    "playwright": "^1.61.0",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^3"
  }
}
