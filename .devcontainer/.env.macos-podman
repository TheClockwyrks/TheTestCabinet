# Environment for a rootless Podman host on macOS (`podman machine`). Copy this
# to .env (see README.md), paired with docker-compose.macos-podman.yml.
#
# The UID/GID here are the ones the IMAGE builds its user with. They do not need
# to match your Mac account's — docker-compose.macos-podman.yml's
# `userns_mode: keep-id:uid=1000,gid=1000` maps the machine user onto them,
# whatever it is numbered. (This is the difference from .env.podman, where the
# GID of 100 mirrors a NixOS host's `users` group because that variant maps onto
# the host's real numbering.)
DEVCONTAINER_USERNAME=ttc
DEVCONTAINER_UID=1000
DEVCONTAINER_GID=1000

# The host container-runtime socket that docker-compose.yml binds to
# /var/run/docker.sock in the container, for the Docker-outside-of-Docker local
# service stack. THIS IS A PATH INSIDE THE PODMAN MACHINE VM, not on your Mac —
# compose hands the string to the runtime, which resolves it where it runs. So
# neither the Mac-side socket that `podman machine inspect` prints nor the
# rootful /run/podman/podman.sock is the right answer here: it has to be the
# *rootless* socket of the same user VS Code created this container as, or
# `deployments/local`'s Makefile cannot even `docker inspect` this container to
# find where the workspace came from.
#
# 501 is that user's UID on a stock machine (podman numbers it to match the first
# macOS account). Confirm yours, or let setup-host.sh fill this line in for you:
#
#   podman machine ssh 'echo /run/user/$(id -u)/podman/podman.sock'
DOCKER_SOCKET=/run/user/501/podman/podman.sock
