# Environment for a rootless Podman host on macOS (`podman machine`). Copy this
# to .env (see README.md), paired with docker-compose.macos-podman.yml.
#
# The UID/GID here are the ones the IMAGE builds its user with. They do not need
# to match your Mac account's — docker-compose.macos-podman.yml's
# `userns_mode: keep-id:uid=1000,gid=1000` maps the machine user onto them,
# whatever it is numbered. (This is the difference from .env.podman, where the
# GID of 100 mirrors a NixOS host's `users` group because that variant maps onto
# the host's real numbering.)
DEVCONTAINER_USERNAME=ttc
DEVCONTAINER_UID=1000
DEVCONTAINER_GID=1000

# THERE IS DELIBERATELY NO `DOCKER_SOCKET` HERE, and it is the one line you might
# come looking for. The other three host rows bind a container-runtime socket in
# for the local service stack; this one has no socket it can bind, because a bind
# mount's source is a path on your MAC and podman's socket lives inside the
# machine VM. Setting it to the VM path does not fail late or partially — podman
# refuses the whole `up`:
#
#   Error: statfs /private/var/run/user/501/podman/podman.sock:
#   no such file or directory
#
# So `make -C deployments/local local-up` is not available from inside the
# container on this row. The devcontainer itself does not depend on it. See
# .devcontainer/README.md, "Podman on macOS".
