{
	"name": "The Test Cabinet",
	"dockerComposeFile": [
		"docker-compose.yml",
		"docker-compose.local.yml"
	],
	"service": "dev",
	"workspaceFolder": "/workspaces/the-test-cabinet",
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"DavidAnson.vscode-markdownlint",
				"EditorConfig.EditorConfig",
				"timonwong.shellcheck",
				"yzhang.markdown-all-in-one",
				"aaron-bond.better-comments"
			]
		}
	},
	"forwardPorts": [],
	// The cargo-target named volume persists across rebuilds; if it was ever
	// created root-owned (e.g. before the Dockerfile pre-created its mountpoint),
	// reclaim it for the container user so CARGO_TARGET_DIR stays writable.
	//
	// gg's eleven program-language toolchains are installed here rather than in the image
	// because they are pinned by the REPOSITORY — each arm's own
	// packages/gg-sandbox-*/<lang>-version.sh — rather than by the container, and the
	// repository is only mounted from this point on. That reasoning has not changed; what
	// has changed is how much rides on it. These are no longer only what gg's TESTS for
	// those arms need: `crates/gg/build.rs` reflects each arm's signature catalogue out of
	// its own SDK with that arm's own documentation tool on every build, because the
	// catalogues are generated rather than committed. So a container without them cannot
	// `cargo build --workspace`, cannot `cargo clippy`, and fails the pre-commit hooks that
	// run both — this is a prerequisite for working in the repository at all, not a
	// prerequisite for one crate's test suite.
	//
	// One script installs the lot (scripts/ci/install-gg-toolchains.sh) rather than a line
	// per arm, so that this file, CI, the release workflow and the driver image's gg build
	// stage all provision from one pinned list. It is ~1.9 GB installed — a Swift toolchain
	// and its wasm SDK, a JDK and TeaVM's jars, wasi-sdk, .NET and Roslyn, `purs` and
	// `esbuild`, the Kotlin compiler, the wasm32 standard library, uv and YARD — and it
	// downloads a good deal more than that on a first create, because several of those
	// installers keep a pruned fraction of a much larger published archive. It is
	// idempotent, so re-running it after a failure costs nothing for the parts that landed.
	//
	// `npm ci` is the eleventh toolchain, and it is here for the same reason the other ten
	// are: TWO of the arms — TypeScript and JavaScript — are reflected through the pinned
	// `typescript` that lives in the npm workspaces, so a container whose workspaces were
	// never installed cannot `cargo build` the Rust workspace at all. The installer above
	// deliberately will not run it (`npm ci` deletes and re-creates node_modules, which is a
	// thing to do to a checkout on purpose rather than as a side effect of installing
	// compilers), and every other surface that builds gg — the Azure rust job, ci.yml, the
	// release workflow, the driver image's gg stage — pairs the two calls exactly like this.
	// On a first create there is no node_modules to lose, which is what makes it safe here.
	"postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" /cargo-target && (bash scripts/setup-hooks.sh || echo 'setup-hooks failed; run scripts/setup-hooks.sh manually') && (bash scripts/ci/install-gg-toolchains.sh || echo 'install-gg-toolchains failed; building test-cabinet-gg needs them \u2014 run scripts/ci/install-gg-toolchains.sh manually') && (npm ci || echo 'npm ci failed; the workspaces hold the typescript that reflects two of gg\u2019s eleven arms \u2014 run npm ci manually')",
	"postStartCommand": "bash .devcontainer/tools/docker-socket-access.sh || true; if [ -S /tmp/ssh-agent.sock ]; then rm -f /tmp/devcontainer-ssh-agent.sock && (sudo socat UNIX-LISTEN:/tmp/devcontainer-ssh-agent.sock,fork,mode=0666 UNIX-CONNECT:/tmp/ssh-agent.sock >/tmp/ssh-agent-socat.log 2>&1 &); fi",
	"updateRemoteUserUID": false
}
