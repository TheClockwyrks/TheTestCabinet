# The environment for Podman on macOS (Apple silicon). Copy it to `.env`
# beside `docker-compose.yml`:
#
#   cp .devcontainer/.env.macos .devcontainer/.env
#
# Compose reads `.env` from the directory the compose file sits in, so these
# reach the compose file whether the container is started by an editor's
# Reopen in Container or by `devcontainer up`; a variable already set in the
# environment wins over the file. `.env` is ignored by git, because the values
# are this machine's. See "Host files" and "Podman on macOS" in README.md.

# The container user's ids. Podman runs containers in a Linux VM, and
# `keep-id` maps the VM user the Mac's account is presented as onto the
# container user, so the checkout, which reaches the VM over virtiofs, stays
# writable inside. The VM user is 1000:1000 whatever the Mac's own ids are.
# The mapping repeats the numbers rather than naming the variables, for the
# reason .env.podman gives.
DEVCONTAINER_UID=1000
DEVCONTAINER_GID=1000
DEVCONTAINER_USERNS=keep-id:uid=1000,gid=1000

# Nothing on a Mac can be bound in as the host runtime or the SSH agent:
# Podman resolves a bind source on the Mac, where neither the VM's socket nor
# the agent's can be mounted. Both arrive over the Mac's loopback instead,
# which a container reaches as host.containers.internal. The runtime's port is
# what tools/macos-host-runtime.sh forwards into the VM, and the agent's is
# what a launchd agent running socat forwards to $SSH_AUTH_SOCK; start both on
# the Mac before the container. Should the name not resolve, put
# 192.168.127.254, where the machine's gvproxy answers for the Mac, in its
# place.
DEVCONTAINER_RUNTIME_SOCKET=/dev/null
DEVCONTAINER_RUNTIME_TCP=host.containers.internal:17386
DEVCONTAINER_SSH_AGENT_TCP=host.containers.internal:17385

# No NVIDIA GPU exists behind a Mac's container runtime, so the CUDA toolkit
# would be several GB the image can never use.
INSTALL_CUDA=false
