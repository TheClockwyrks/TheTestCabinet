# The environment for rootless Podman on Linux, which is what every Linux
# machine in the fleet runs. Copy it to `.env` beside `docker-compose.yml`:
#
#   cp .devcontainer/.env.podman .devcontainer/.env
#
# Compose reads `.env` from the directory the compose file sits in, so these
# reach the compose file whether the container is started by an editor's
# Reopen in Container or by `devcontainer up`; a variable already set in the
# environment wins over the file. `.env` is ignored by git, because the values
# are this machine's. See "Host files" in README.md.

# The host user's ids, from `id`. The image creates the container user with
# them, and `keep-id` maps the host user onto that user inside the container,
# so a file the container writes into the checkout stays owned by you on the
# host. A per-user primary group is 1000 on Ubuntu; NixOS commonly gives every
# user `users`, which is 100. The mapping repeats the two numbers rather than
# naming the variables, because a value this file names from itself is
# resolved from the file ahead of the environment by podman-compose, and a
# variable exported over the file would then reach the build and not the
# mapping. Change all three together, and the socket path below with the uid.
DEVCONTAINER_UID=1000
DEVCONTAINER_GID=1000
DEVCONTAINER_USERNS=keep-id:uid=1000,gid=1000

# Rootless Podman's per-user API socket, which the container drives as its
# host runtime, under the uid above. Enable it once with `systemctl --user
# enable --now podman.socket`, and confirm the path with
# `podman info --format '{{.Host.RemoteSocket.Path}}'`.
DEVCONTAINER_RUNTIME_SOCKET=/run/user/1000/podman/podman.sock

# The host's SSH agent, bound in so `git push` over SSH works inside. An
# editor started from a launcher rather than a shell may carry no
# SSH_AUTH_SOCK; write the agent's path here then, from `echo $SSH_AUTH_SOCK`
# in a terminal. `/dev/null` binds nothing and the agent is skipped.
DEVCONTAINER_SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-/dev/null}

# The CUDA toolkit, off unless something in this checkout compiles CUDA
# sources: it is several GB. Turn it on beside docker-compose.nvidia.yml on a
# host whose GPU it can use. See "GPU access" in README.md.
INSTALL_CUDA=false
