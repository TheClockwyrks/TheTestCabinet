# The Test Cabinet — dispatcher environment file (`tcab-dispatcher`).
#
# Copy this file to `.env.dispatcher` and fill in real values:
#
#     cp .env.dispatcher.example .env.dispatcher
#
# The dispatcher reads its whole configuration from the environment (no config
# file, no flags, no HTTP server). Variables already exported in your shell take
# precedence over the file, so a systemd unit or container can export them
# directly. In a Kubernetes deployment these come from deployments/k8s/dispatcher.yaml
# and its secret; this file documents every variable for reference and for a
# host-run dispatcher pointed at a remote cluster.
#
# `.env.dispatcher` is gitignored; this `.env.dispatcher.example` is committed with
# placeholder values only. Never put a real secret in `.env.dispatcher.example`.

# ── Backend (the run queue the dispatcher drains) ────────────────────────────

# REQUIRED. The backend the dispatcher claims queued jobs from and reports driver-
# pod deaths to.
TCAB_BACKEND_URL=https://backend.example.com

# REQUIRED. The shared service token authenticating the claim. The BACKEND must
# carry the same value (its TCAB_BACKEND_SERVICE_TOKEN) or the queue never drains.
TCAB_BACKEND_SERVICE_TOKEN=REPLACE_ME

# ── Driver Jobs the dispatcher creates ───────────────────────────────────────

# REQUIRED. The driver container image each created Job's pod runs. Pin the same
# :<git-sha> tag the dispatcher image is pinned to so they version together.
TCAB_DRIVER_IMAGE=ghcr.io/REPLACE_OWNER/tcab-driver:latest

# The namespace the dispatcher creates driver Jobs in. Default: the dispatcher's
# own in-cluster namespace, else `default`.
#TCAB_DISPATCHER_NAMESPACE=tcab-prod

# The ServiceAccount assigned to each driver pod — the identity (rbac.yaml) that
# can create/exec/delete the untrusted sandbox pods. Default: the namespace default.
#TCAB_DISPATCHER_DRIVER_SA=tcab-driver

# Comma-separated Secret names mounted into each driver Job's env (via envFrom).
# This is how the harness provider API key reaches the run engine. Default: none.
#TCAB_DISPATCHER_DRIVER_SECRETS=tcab-driver-secrets

# Queue admission: the most non-terminal driver Jobs kept in flight. Default: 8
#TCAB_DISPATCHER_MAX_INFLIGHT=8

# Back-off after an empty claim or a full in-flight cap, in seconds. Default: 2
#TCAB_DISPATCHER_POLL_INTERVAL_SECONDS=2

# ttlSecondsAfterFinished on each driver Job, for automatic cleanup. Default: 300
#TCAB_DISPATCHER_JOB_TTL_SECONDS=300

# ── Sandbox-pod settings, PASSED THROUGH into each driver Job ─────────────────
#
# The dispatcher does not consume these; the driver does. They scope the SANDBOX
# pods the driver creates. See the driver's KubernetesConfig for the full set.
#TCAB_K8S_NAMESPACE=tcab-prod
#TCAB_K8S_RUN_CPU_REQUEST=500m
#TCAB_K8S_RUN_CPU_LIMIT=2
#TCAB_K8S_RUN_MEMORY_REQUEST=1Gi
#TCAB_K8S_RUN_MEMORY_LIMIT=4Gi
#TCAB_K8S_IMAGE_PULL_SECRETS=tcab-registry

# The artifact service each driver uploads its produced run tree to (forwarded into
# every driver Job). Unset skips the upload. Default: none.
#TCAB_ARTIFACTS_URL=http://tcab-artifacts:8790

# ── Telemetry (OpenTelemetry / OTLP) ─────────────────────────────────────────
#
# Telemetry is OPT-IN. With OTEL_EXPORTER_OTLP_ENDPOINT unset (the default), the
# dispatcher logs to stdout — no exporter, no collector needed.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_SERVICE_NAME=tcab-dispatcher

# Sets the `deployment.environment.name` resource attribute. Default: local
#TCAB_ENV=local
