# The Test Cabinet — backend server environment file (`tcab-backend`).
#
# Copy this file to `.env.backend` and fill in real values:
#
#     cp .env.backend.example .env.backend
#
# The backend loads `.env.backend` on startup (searching the working directory
# and its parents). Variables already exported in your shell take precedence
# over the file, so a systemd unit or container can export them directly.
#
# `.env.backend` is gitignored; this `.env.backend.example` is committed with
# placeholder values only. Never put a real secret in `.env.backend.example`.

# ── Core ─────────────────────────────────────────────────────────────────────

# REQUIRED. Path to the repo checkout ingested on `POST /ingest`. The only
# unconditionally required variable; the backend refuses to start without it.
TCAB_BACKEND_CHECKOUT=/srv/test-cabinet/checkout

# Address the Axum server binds. Bind to a private-network IP (e.g. a Tailscale
# address) in production — there is no app-level auth. Default: 127.0.0.1:8787
#TCAB_BACKEND_BIND=127.0.0.1:8787

# Path to the embedded SQLite file. Default: ./tcab-backend.sqlite
#TCAB_BACKEND_DB=./tcab-backend.sqlite

# On-disk definition store. Default: ./tcab-store
#TCAB_BACKEND_STORE=./tcab-store

# ── R2 snapshot upload ───────────────────────────────────────────────────────
#
# The R2 (S3-compatible) bucket the public site snapshot is uploaded to. All
# four of ACCOUNT_ID/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY are required
# together for production; if any is unset the upload is disabled and the
# backend still records to SQLite and regenerates the snapshot on disk (a
# dev-only mode).
TCAB_R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TCAB_R2_BUCKET=test-cabinet-snapshot
TCAB_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TCAB_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. The S3 endpoint, derived from the account id when unset.
#TCAB_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── Deploy hook ──────────────────────────────────────────────────────────────

# The Cloudflare Pages deploy hook fired after each snapshot upload. Required
# for production publishing; unset disables the hook (dev only).
TCAB_SITE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxxxxxx

# ── Tuning ───────────────────────────────────────────────────────────────────

# The coalescing window (milliseconds) for bursts of publishes. Default: 5000
#TCAB_SNAPSHOT_COALESCE_MS=5000

# Optional override for the headless browser used to render references at
# ingest. Consumed by the bundled driver.
#TCAB_REFERENCE_BROWSER=/usr/bin/chromium
