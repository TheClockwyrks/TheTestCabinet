# The Test Cabinet — backend server environment file (`tcab-backend`).
#
# Copy this file to `.env.backend` and fill in real values:
#
#     cp .env.backend.example .env.backend
#
# The backend loads `.env.backend` on startup (searching the working directory
# and its parents). Variables already exported in your shell take precedence
# over the file, so a systemd unit or container can export them directly.
#
# `.env.backend` is gitignored; this `.env.backend.example` is committed with
# placeholder values only. Never put a real secret in `.env.backend.example`.

# ── Core ─────────────────────────────────────────────────────────────────────

# REQUIRED. Path to the test-suites checkout ingested on `POST /ingest`, with a
# cold-storage checkout beside it. The only unconditionally required variable;
# the backend refuses to start without it.
TCAB_BACKEND_CHECKOUT=/srv/test-cabinet/test-suites

# Address the Axum server binds. Bind to a private-network IP (e.g. a Tailscale
# address) in production — there is no app-level auth. Default: 127.0.0.1:8787
#TCAB_BACKEND_BIND=127.0.0.1:8787

# Database connection URL. The scheme selects the backend (via SeaORM):
#   - SQLite (local/dev): a file URL, created if missing with `?mode=rwc`.
#   - PostgreSQL (deployment): a `postgres://` URL to a managed instance, which
#     also makes the backend stateless (no local DB file or single-replica
#     caveat). The schema is migrated automatically on startup.
# Default: sqlite://./tcab-backend.sqlite?mode=rwc
#TCAB_BACKEND_DATABASE_URL=sqlite://./tcab-backend.sqlite?mode=rwc
#TCAB_BACKEND_DATABASE_URL=postgres://tcab:password@db.internal:5432/tcab

# On-disk definition store. Default: ./tcab-store
#TCAB_BACKEND_STORE=./tcab-store

# The directory ingest reads the authored definitions from: `test-cases/`,
# `game-jams/`, `test-case-groups/` and `test-cases/reference-builds.lock.json`
# beneath it. Set it when those trees are cloned apart from the checkout.
# Default: $TCAB_BACKEND_CHECKOUT
#TCAB_DEFINITIONS_ROOT=/srv/test-cabinet/definitions

# The test suites tree ingest reads (`<slug>/suite.toml`, `<slug>/versions/…`).
# It holds one folder per suite; a folder without a `suite.toml` is ignored.
# Default: $TCAB_BACKEND_CHECKOUT/test-suites
#TCAB_SUITES_ROOT=/srv/test-cabinet/test-suites

# The cold-storage root ingest copies each version's baseline validation media
# from, mirrored beneath it at the version folder's path relative to
# TCAB_DEFINITIONS_ROOT. The default is the `cold-storage` checkout beside the
# test-suites checkout; when it is not there, every version ingests with no
# baseline media.
# TCAB_COLD_STORAGE_ROOT takes precedence over TCAB_COLD_STORAGE_DIR, the
# override the tcab capture commands also read.
# Default: $TCAB_COLD_STORAGE_DIR, else $TCAB_BACKEND_CHECKOUT/../cold-storage
#TCAB_COLD_STORAGE_ROOT=/srv/test-cabinet/cold-storage
#TCAB_COLD_STORAGE_DIR=/srv/test-cabinet/cold-storage

# The directory holding gg's reference documents — `index.json` plus one
# `<language>.json` per program language — which the backend serves at
# `GET /gg/reference` and `GET /gg/reference/{language}` for the console's gg
# Reference section. They are written by the gg binary itself (`gg reference --out`),
# because the backend cannot link the crate that projects them.
#
# The backend image bakes them and sets this to /opt/gg-reference. Running the binary
# from a checkout, run `scripts/gg-reference.sh` in the gg checkout, which writes to
# gg/target/gg-reference, and point this there; until you do, the two reference
# endpoints answer 503 with a message naming that script and nothing else about the
# backend is affected.
# Default: $TCAB_BACKEND_CHECKOUT/target/gg-reference
#TCAB_GG_REFERENCE=/absolute/path/to/the-test-cabinet/gg/target/gg-reference

# ── Identity ─────────────────────────────────────────────────────────────────
#
# Every request carries an identity: the Cloudflare Access assertion the edge adds,
# the service token, or a per-job token. The two TCAB_ACCESS_* variables are set
# together: with both, the backend verifies `Cf-Access-Jwt-Assertion`; with neither
# (local development) it takes the identity from `Cf-Access-Authenticated-User-Email`
# as presented; one set alone refuses to start.
#TCAB_ACCESS_TEAM_DOMAIN=shrill-term-5c16.cloudflareaccess.com
#TCAB_ACCESS_AUDIENCE=REPLACE_ME

# The service token in-cluster callers (the dispatcher, the arena, ingest) present,
# and the one the backend presents to the artifact service: the public dataset is
# written through the artifact service under it, so publishing needs it beside
# TCAB_ARTIFACTS_URL.
#TCAB_BACKEND_SERVICE_TOKEN=REPLACE_ME

# ── Artifact service ─────────────────────────────────────────────────────────
#
# A run's playable build, its proof/asset media, and its recorded logs live on the
# separate artifact service. The console reaches it under its own origin at
# /artifacts; the backend advertises no URL for it.

# The address THIS PROCESS calls: pruning a deleted run's tree, the reclamation
# sweep, and the public dataset's writes (PUT /public/{key}, GET /public,
# DELETE /public/{key} and a run's publish-media), which are the only way the
# backend reaches the public bucket, all go through it. Unset, all of them are
# disabled: a publish still records into the database and regenerates the dataset,
# but writes nothing. In a cluster this is in-cluster Service DNS
# (http://tcab-artifacts:8790); running the binary outside the cluster, point it at
# whatever address the artifact service is reachable on from here.
#TCAB_ARTIFACTS_URL=http://127.0.0.1:8790

# How often (hours) the reclamation sweep deletes the artifact trees no run row
# references. 0 disables the sweep, leaving the delete-time prune as the only
# reclamation. Default: 6
#TCAB_ARTIFACT_SWEEP_INTERVAL_HOURS=6

# How old (hours) a tree with no run row must be before a sweep deletes it. A driver
# uploads a run's tree before it reports the run terminal, so this window is what
# protects a run that is still finishing. Default: 24
#TCAB_ARTIFACT_SWEEP_GRACE_HOURS=24

# ── Model probes ──────────────────────────────────────────────────────────────────────
#
# The OpenRouter API key the backend's own completion calls are billed to —
# today only the model probes (the RaC-readiness checks triggered from the
# console's Models section). Distinct from the runners' OPENROUTER_API_KEY,
# which is injected into run containers, never into the backend. Unset, every
# keyless OpenRouter read (the public catalog) keeps working and a probe
# trigger fails with the structured `openrouter_key_missing` error.
#TCAB_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# ── Tuning ───────────────────────────────────────────────────────────────────

# The coalescing window (milliseconds) for bursts of publishes. A SLIDING debounce:
# each publish restarts the window, so a batch regenerates the snapshot once rather
# than once per run. Default: 60000
#TCAB_SNAPSHOT_COALESCE_MS=60000

# How long (hours) a superseded snapshot generation is kept in the bucket before the
# refresh prunes it. The generation index.json points at is never pruned, whatever
# its age; this bounds only the ones nothing references any more, and the window
# gives an in-flight site build time to finish. 0 prunes on the next refresh.
# Default: 24
#TCAB_SNAPSHOT_RETENTION_HOURS=24

# Also ingest the test suite previews The Spec Cabinet writes to the suites
# checkout's `.previews/` folder. This belongs to local development only: previews
# are experimental and exist only in the checkout they were written to, so no
# deployment beyond a developer's own stack sets it. Default: false
#TCAB_BACKEND_INGEST_PREVIEWS=true

# The ingest sidecar's localhost endpoint that refreshes the checkout to the tip of
# the branch the environment ingests. A POST /ingest asking for `refresh` calls it
# before the scan. The staging and prod overlays set it; unset (a backend with no
# sidecar), `refresh` is ignored and the checkout is scanned as it is.
#TCAB_BACKEND_INGEST_REFRESH_URL=http://127.0.0.1:8788/cgi-bin/refresh

# Optional override for the headless browser used to render references at ingest,
# forwarded to the bundled driver as the Chromium it launches. Leave unset to use
# the Playwright-managed Chromium baked into the backend image.
#TCAB_REFERENCE_BROWSER=/usr/bin/chromium

# ── Telemetry (OpenTelemetry / OTLP) ─────────────────────────────────────────
#
# Telemetry is OPT-IN. With OTEL_EXPORTER_OTLP_ENDPOINT unset (the default), the
# backend logs to stdout exactly as before — no exporter, no collector needed.
# Set the endpoint to export traces, metrics, and logs over OTLP/HTTP.
#
# The local Grafana LGTM stack runs IN THE k3d CLUSTER (deployments/k8s/
# components/observability), not the devcontainer. When this backend runs in the
# cluster (`make -C deployments/local local-up`) the local overlay points it at the
# in-cluster collector (http://tcab-lgtm:4318) for you — no setting needed here.
# This file is for running the binary OUTSIDE the cluster (a `cargo run`): forward
# the collector with `make -C deployments/local local-grafana` and use localhost.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The binaries always export over HTTP/protobuf; this is the SDK default when
# the endpoint is the :4318 HTTP port, so it normally needs no override.
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTel service.name. Defaults to the value the binary seeds (`tcab-backend`);
# uncomment only to override.
#OTEL_SERVICE_NAME=tcab-backend

# Sets the `deployment.environment.name` resource attribute. Default: local
#TCAB_ENV=local
