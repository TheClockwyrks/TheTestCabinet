# The Test Cabinet — worker server environment file (`tcab-worker`).
#
# Copy this file to `.env.worker` and fill in real values:
#
#     cp .env.worker.example .env.worker
#
# The worker loads `.env.worker` on startup (searching the working directory and
# its parents). Variables already exported in your shell take precedence over
# the file, so a systemd unit or container can export them directly.
#
# `.env.worker` is gitignored; this `.env.worker.example` is committed with
# placeholder values only. Never put a real secret in `.env.worker.example`.

# ── Worker server ────────────────────────────────────────────────────────────

# REQUIRED. The backend the worker resolves definitions from and publishes runs
# to. A worker is always backend-driven (it has no local `test-cases/` checkout).
TCAB_BACKEND_URL=https://backend.example.com

# Address the Axum server binds. Bind to a private-network IP (e.g. a Tailscale
# address) in production — there is no app-level auth. Default: 127.0.0.1:8788
#TCAB_WORKER_BIND=127.0.0.1:8788

# Directory each run's record and collected implementation is written under.
# Default: ./runs
#TCAB_WORKER_OUT_DIR=./runs

# Staging directory for a run's mountable inputs (seeds, artifacts, capture
# scratch, materialized definitions). On macOS/Windows this must be a path the
# container runtime's VM shares with the host. Default: ./.tcab-worker
#TCAB_WORK_DIR=./.tcab-worker

# ── Harness API keys ─────────────────────────────────────────────────────────
#
# A worker run injects the harness key into the run container. You only need the
# key for the harness(es) the worker will run:
#
#   claude                         -> ANTHROPIC_API_KEY
#   codex                          -> OPENAI_API_KEY (injected as CODEX_API_KEY)
#   cline, goose, kilo, opencode,  -> OPENROUTER_API_KEY
#   pi
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Publishing release credentials ───────────────────────────────────────────
#
# A worker can also publish, which shells out to the `gh` and `wrangler` CLIs.
# These are NOT read by the worker itself but by those tools from the
# environment.

# GitHub token used by `gh` to create and push per-run source repositories
# (`GH_TOKEN` also works).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare API token used by `wrangler` to deploy per-run playable builds to
# Cloudflare Pages. Needs the "Pages: Edit" permission.
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Publish target (per-run repo owner + Pages project) ──────────────────────
#
# The GitHub org the per-run source repos are created under, and the Cloudflare
# Pages project the per-run builds deploy to. The defaults are shown; override
# only if you publish into a different org/project.
#TCAB_GITHUB_ORG=TheClockwyrks
#TCAB_PAGES_PROJECT=test-cabinet-runs

# ── Telemetry (OpenTelemetry / OTLP) ─────────────────────────────────────────
#
# Telemetry is OPT-IN. With OTEL_EXPORTER_OTLP_ENDPOINT unset (the default), the
# worker logs to stdout exactly as before — no exporter, no collector needed.
# Set the endpoint to export traces, metrics, and logs over OTLP/HTTP.
#
# The worker runs on the HOST, so it reaches the local Grafana LGTM stack at
# localhost against the ports the devcontainer publishes. (An in-container
# process would use http://lgtm:4318 instead — see
# .devcontainer/docker-compose.yml.)
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# The binaries always export over HTTP/protobuf; this is the SDK default when
# the endpoint is the :4318 HTTP port, so it normally needs no override.
#OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTel service.name. Defaults to the value the binary seeds (`tcab-worker`);
# uncomment only to override.
#OTEL_SERVICE_NAME=tcab-worker

# Sets the `deployment.environment.name` resource attribute. Default: local
#TCAB_ENV=local
