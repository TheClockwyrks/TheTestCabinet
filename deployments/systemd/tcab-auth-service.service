# tcab-auth-service as a systemd service — for the VM fallback where the auth
# service runs on a host instead of Azure Container Apps (see deployment/azure.md).
#
# Install:
#   sudo cp deployments/systemd/tcab-auth-service.service /etc/systemd/system/
#   sudo install -Dm600 deployments/env/auth.<env>.env.example /etc/test-cabinet/auth.env  # then edit
#   sudo systemctl enable --now tcab-auth-service.service

[Unit]
Description=The Test Cabinet auth service (tcab-auth-service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/test-cabinet/auth.env
WorkingDirectory=/var/lib/test-cabinet
ExecStart=/usr/local/bin/tcab-auth-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
