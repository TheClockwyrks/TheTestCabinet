# Backend — STAGING overlay.
#
# Thin, environment-specific overlay. The repo-root .env.backend.example is the
# AUTHORITATIVE reference for every variable the backend reads; copy any others
# you need from there. Supply secrets from your secret store, never from a
# committed file.

# Bind on all interfaces inside the managed container / on the private-network
# address on a VM. Reachability is restricted by the network, not the bind.
TCAB_BACKEND_BIND=0.0.0.0:8787

# State paths (match the mounted volume in containerapp.yaml / the VM's disk).
TCAB_BACKEND_DB=/state/tcab-backend.sqlite
TCAB_BACKEND_STORE=/state/tcab-store
TCAB_BACKEND_CHECKOUT=/state/checkout

# Tags telemetry/logs for this environment.
TCAB_ENV=staging

# ── Secrets: set via the platform secret store, not here ──
#TCAB_R2_ACCOUNT_ID=
#TCAB_R2_BUCKET=test-cabinet-snapshot-staging
#TCAB_R2_ACCESS_KEY_ID=
#TCAB_R2_SECRET_ACCESS_KEY=
#TCAB_SITE_DEPLOY_HOOK_URL=

# ── Telemetry (opt-in) — see development/observability.md ──
#OTEL_EXPORTER_OTLP_ENDPOINT=
