# Backend — PROD overlay.
#
# Thin, environment-specific overlay. The repo-root .env.backend.example is the
# AUTHORITATIVE reference for every variable the backend reads; copy any others
# you need from there. Supply secrets from your secret store, never from a
# committed file.

# Bind on all interfaces inside the pod; the ClusterIP Service fronts it.
# Reachability is restricted by the cluster network, not the bind.
TCAB_BACKEND_BIND=0.0.0.0:8787

# State paths (match the PVC mounted in deployments/k8s/base/backend.yaml).
# The SQLite file URL is the single-replica shape; point this at a `postgres://`
# instance instead to run the backend stateless (see deployment/backups.md).
TCAB_BACKEND_DATABASE_URL=sqlite:///state/tcab-backend.sqlite?mode=rwc
TCAB_BACKEND_STORE=/state/tcab-store
TCAB_BACKEND_CHECKOUT=/state/checkout
# Ingest's three trees default to the checkout's own (test-cases/ and its
# siblings, test-suites/, cold-storage/). Set these only when the sidecar clones
# a tree as its own checkout beside /state/checkout.
#TCAB_DEFINITIONS_ROOT=/state/checkout
#TCAB_SUITES_ROOT=/state/checkout/test-suites
#TCAB_COLD_STORAGE_ROOT=/state/checkout/cold-storage

# The Access application whose assertion the backend verifies on every request that
# crosses the edge: the team domain and the origin's audience tag (patch-access.yaml
# in the overlay). Set both, or neither for a local backend with no edge in front.
#TCAB_ACCESS_TEAM_DOMAIN=shrill-term-5c16.cloudflareaccess.com
#TCAB_ACCESS_AUDIENCE=<the audience tag of the origin's Access application>

# The artifact service THIS BACKEND calls, by its in-cluster Service name: it prunes
# a deleted run's tree, sweeps the trees no run row references and writes the public
# snapshot. The console reaches it at /artifacts/ of its own origin instead.
TCAB_ARTIFACTS_URL=http://tcab-artifacts:8790

# Tags telemetry/logs for this environment.
TCAB_ENV=prod

# ── Secrets: set via the platform secret store, not here ──
# TCAB_BACKEND_SERVICE_TOKEN is the shared service token the dispatcher, the arena
# and the ingest sidecar present, and the one the backend presents to artifacts.
#TCAB_BACKEND_SERVICE_TOKEN=
# TCAB_OPENROUTER_API_KEY enables model probes (usually the same OpenRouter key
# the driver secret carries).
# The TCAB_R2_* keys of the backend's Secret name the public dataset's bucket; the
# artifacts service reads the same keys (deployments/k8s/base/artifacts.yaml), and
# is the one writer of that bucket.
#TCAB_R2_ACCOUNT_ID=
#TCAB_R2_BUCKET=test-cabinet-snapshot
#TCAB_R2_ACCESS_KEY_ID=
#TCAB_R2_SECRET_ACCESS_KEY=
#TCAB_OPENROUTER_API_KEY=
#TCAB_SITE_DEPLOY_HOOK_URL=

# ── Telemetry (opt-in) — see deployment/telemetry.md + development/observability.md ──
# Default: the in-cluster Grafana LGTM stack (the observability component). The k8s
# overlay sets this on the pod via its env patch; shown here as the env-file mirror.
# Point it at Grafana Cloud / an external collector (and drop the component) instead
# if you don't want the in-cluster stack.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tcab-lgtm:4318
# If the collector needs auth (e.g. Grafana Cloud) — set from the secret store:
#OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic <token>
