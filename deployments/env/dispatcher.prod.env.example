# Dispatcher — PROD overlay.
#
# Thin, environment-specific overlay. The repo-root .env.dispatcher.example is the
# AUTHORITATIVE reference for every variable the dispatcher reads; copy any others
# you need from there. Supply secrets from your secret store, never from a
# committed file.
#
# These values mirror what deployments/k8s/dispatcher.yaml sets as container env vars.

# The backend (the run queue this dispatcher drains) and the shared service token.
TCAB_BACKEND_URL=http://tcab-backend:8787
# From the secret store; MUST match the backend's TCAB_BACKEND_SERVICE_TOKEN.
#TCAB_BACKEND_SERVICE_TOKEN=

# The driver image each created Job runs (pin a :<git-sha> in a real deployment).
TCAB_DRIVER_IMAGE=ghcr.io/REPLACE_OWNER/tcab-driver:latest

# Namespace + ServiceAccount for the driver Jobs the dispatcher creates.
TCAB_DISPATCHER_NAMESPACE=tcab-prod
TCAB_DISPATCHER_DRIVER_SA=tcab-driver

# Secret(s) mounted into each driver Job's env (the harness API key reaches the run
# engine this way). From the secret store.
TCAB_DISPATCHER_DRIVER_SECRETS=tcab-driver-secrets

# Queue admission + polling + Job cleanup.
TCAB_DISPATCHER_MAX_INFLIGHT=8
TCAB_DISPATCHER_POLL_INTERVAL_SECONDS=2
TCAB_DISPATCHER_JOB_TTL_SECONDS=300

# Tags telemetry/logs for this environment.
TCAB_ENV=prod

# ── Sandbox-pod settings, passed THROUGH into each driver Job ──────────────────
TCAB_K8S_NAMESPACE=tcab-prod
TCAB_K8S_RUN_CPU_REQUEST=500m
TCAB_K8S_RUN_CPU_LIMIT=2
TCAB_K8S_RUN_MEMORY_REQUEST=1Gi
TCAB_K8S_RUN_MEMORY_LIMIT=4Gi
#TCAB_K8S_IMAGE_PULL_SECRETS=tcab-registry

# The artifact service each driver uploads its produced run tree to.
TCAB_ARTIFACTS_URL=http://tcab-artifacts:8790

# ── Telemetry (opt-in) — see deployment/telemetry.md + development/observability.md ──
#OTEL_EXPORTER_OTLP_ENDPOINT=
#OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic <token>
