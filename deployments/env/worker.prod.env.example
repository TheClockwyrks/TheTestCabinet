# Worker — PROD overlay.
#
# Thin, environment-specific overlay. The repo-root .env.worker.example is the
# AUTHORITATIVE reference for every variable the worker reads (harness keys,
# publish credentials, work/out dirs); copy any others you need from there.
# Supply secrets from your secret store, never from a committed file.
#
# These values mirror what deployments/k8s/worker.yaml sets as container env vars.

# Spawn each run as a separate pod via the Kubernetes API (the cluster shape).
# Set to `cli` only to use a host Docker/Podman (local development).
TCAB_WORKER_RUNTIME=kubernetes

# The backend and auth service, by their in-cluster Service names.
TCAB_BACKEND_URL=http://tcab-backend:8787
TCAB_AUTH_URL=http://tcab-auth:8789

# Bind on all pod interfaces; the headless Service gives each worker pod a stable
# DNS name addressed individually (there is no load-balanced endpoint — see
# deployment/kubernetes.md).
TCAB_WORKER_BIND=0.0.0.0:8788

# Tags telemetry/logs for this environment.
TCAB_ENV=prod

# ── Kubernetes run-pod settings (used when TCAB_WORKER_RUNTIME=kubernetes) ──
# Namespace run pods are created in. Defaults to the worker's own namespace.
#TCAB_K8S_NAMESPACE=tcab-prod
# ServiceAccount for run pods (defaults to the namespace default SA).
#TCAB_K8S_RUN_SERVICE_ACCOUNT=
# Comma-separated imagePullSecret names for the run-container image (private registry).
#TCAB_K8S_IMAGE_PULL_SECRETS=tcab-registry
# Resource requests/limits applied to each run pod.
TCAB_K8S_RUN_CPU_REQUEST=500m
TCAB_K8S_RUN_CPU_LIMIT=2
TCAB_K8S_RUN_MEMORY_REQUEST=1Gi
TCAB_K8S_RUN_MEMORY_LIMIT=4Gi
# How long to wait for a run pod to reach Running. Default: 180
#TCAB_K8S_POD_READY_TIMEOUT_SECONDS=180
# Name prefix for run pods. Default: tcab-run-
#TCAB_K8S_RUN_POD_PREFIX=tcab-run-
# The worker pod's own IP, for the live asset-preview route (set from the
# downward API in worker.yaml: fieldRef status.podIP).
#TCAB_K8S_POD_IP=

# Where the run-container images are pulled from (defaults to ghcr.io/theclockwyrks).
#TCAB_CONTAINER_REGISTRY=
#TCAB_CONTAINER_TAG=latest

# ── Harness API key(s): only the harness(es) this worker runs. From secret store. ──
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=

# ── Publish credentials, if this worker publishes runs. From secret store. ──
#GITHUB_TOKEN=
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=

# ── Telemetry (opt-in) — see deployment/telemetry.md + development/observability.md ──
#OTEL_EXPORTER_OTLP_ENDPOINT=
# If the collector needs auth (e.g. Grafana Cloud) — set from the secret store:
#OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic <token>
